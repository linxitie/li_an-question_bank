# 数据库配置 - 使用SQLite作为开发环境
DB_TYPE=sqlite
SQLITE_PATH=./data/police_exam.sqlite

# MySQL配置（生产环境使用）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=police_exam
DB_CHARSET=utf8mb4

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_SECRET_KEY=police-exam-jwt-secret-key-2026-must-be-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# 安全配置
BCRYPT_ROUNDS=12

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=True

# 文件上传配置
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads
VIDEO_DIR=./uploads/videos
FILE_DIR=./uploads/files

# 视频转码配置
FFMPEG_PATH=ffmpeg

# 大模型配置
LLM_API_URL=http://localhost:8080/api/v1/chat
LLM_API_KEY=your-llm-api-key

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log