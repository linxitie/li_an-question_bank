# 数据库配置
DB_TYPE=sqlite
SQLITE_PATH=./data/question_bank.db

# JWT 安全配置
JWT_SECRET_KEY=[REMOVED-OLD-JWT]
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 日志
LOG_LEVEL=INFO

# 新闻爬虫浏览器类型 (chromium / firefox / msedge)
NEWS_BROWSER=chromium

# MinerU 扫描件 OCR（2026-10-13 实测固化：环境已验证可用，显式配置防默认值漂移）
MINERU_ENABLED=True
MINERU_PYTHON=C:\mineru_env\Scripts\python.exe
MINERU_TIMEOUT=600

# PaddleOCR 兜底子进程解释器（本机 Python 3.13 不兼容 PaddleOCR，必须独立 venv）
# OCR_MAX_PAGES / OCR_SUBPROCESS_TIMEOUT 不在此固化，沿用 config.py 默认值（8 页 / 240s）
OCR_PYTHON=D:\ocr-env\Scripts\python.exe
