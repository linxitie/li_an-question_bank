# backend/.env.example —— 环境变量模板
#
# 用法：复制为 backend/.env 后填入真实值。backend/.env 已被 .gitignore
# 排除，禁止提交。真实密钥由项目负责人本人填写，勿交由 AI 代填。
#
# ⚠️ 下方所有 <...> 占位符必须替换；保持默认值等于不设防。

# ============ 数据库 ============
# 当前为 SQLite。若换 MySQL，须把 DB_TYPE 改为 mysql 并填全下方四项。
DB_TYPE=sqlite
SQLITE_PATH=./data/question_bank.db
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=<强口令>          # 仅 mysql 模式生效；sqlite 模式不读取
# DB_NAME=police_exam
# DB_CHARSET=utf8mb4

# ============ JWT 安全 ============
# 必须至少 32 字节随机串。生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ 本值已因历史提交泄露并被轮换，切勿复用旧值。
JWT_SECRET_KEY=<至少32字节随机串>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============ 服务器 ============
HOST=0.0.0.0
PORT=8000
# 生产必须为 False —— 为 True 时 seed.py:453 会自动执行种子数据写入
DEBUG=False

# ============ 日志 ============
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ============ 新闻爬虫浏览器 ============
# chromium / firefox / msedge
NEWS_BROWSER=chromium

# ============ MinerU 扫描件 OCR ============
# 仅在走 subprocess 路径时需要指向独立 venv 的解释器；
# 容器化后走 parser sidecar HTTP 路径，可留空。
# MinerU 需要 Python 3.11，OCR 需要 <3.12 —— 均无法在主服务的 3.13 进程内承载。
# 本机实测（2026-10-25）：C:\mineru_env 为 MinerU 3.4.5，CLI 可用。
MINERU_ENABLED=true
# MINERU_PYTHON=/opt/mineru-venv/bin/python
# 超时按页放大：实际预算 = max(MINERU_TIMEOUT, 120 + 75*页数)，封顶 MINERU_TIMEOUT_MAX。
# CPU pipeline 实测 71.2s/页，固定 600s 会让 24 页答案卷必然超时。
MINERU_TIMEOUT=600
# MINERU_SECONDS_PER_PAGE=75
# MINERU_TIMEOUT_MAX=3600
# MINERU_BACKEND=pipeline

# ============ PaddleOCR 兜底 ============
# OCR_PYTHON=/opt/ocr-venv/bin/python
# 上限 30 页：原 8 页会截断 20~30 页的答案解析卷，导致后半答案匹配不到题号。
# OCR_MAX_PAGES=30
# OCR_SUBPROCESS_TIMEOUT=600

# ============ Parser sidecar（容器化后启用）============
# 设置后走 HTTP 调用解析服务；留空则回落到上面的 subprocess 路径。
# PARSER_URL=http://parser:8080

# ============ 大模型 / AI（后期按需补充）============
# 联考小智 llm.py 对应的后端服务
# LLM_API_URL=http://localhost:8080/api/v1/chat
# LLM_API_KEY=
# DeepSeek 密钥（原已泄露并吊销，新密钥由负责人填写）
# DEEP_SEEK_API_KEY=

# ============ 一致性内核 F1（Outbox / 投影 / 对账）============
# 关闭后不建 foundation 表、不启动投递器，等价于 F0 行为（回滚开关）。
FOUNDATION_ENABLED=true
# 投递轮询间隔（毫秒）与最大尝试次数（超限进 dead 并写 data/reports/dead_letters/）。
FOUNDATION_DISPATCH_MS=500
FOUNDATION_MAX_ATTEMPTS=8

# ============ F2 通信统一（WS 中继 / 心跳 / 写入守卫）============
# 单进程留空即可；多 worker（WEB_CONCURRENCY>1）必须设为 redis，
# 否则 lifespan 直接拒绝启动（防止各 worker 只推自己进程内的连接）。
WS_RELAY=
# 超过该秒数无任何消息（含心跳）即关闭连接（码 4008），客户端会自动重连并全量重同步。
WS_HEARTBEAT_TIMEOUT_SECONDS=90
# 写库前 6 类守卫（长度/必填/枚举/JSON/外键/编码）；false 回退 F1 行为。
FOUNDATION_VALIDATION_ENABLED=true

# ============ Redis ============
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0