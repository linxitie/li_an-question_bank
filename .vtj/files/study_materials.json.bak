{
  "id": "study_materials",
  "css": "/* 备考资料面板 */\n.materials-panel {\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 24px;\n  border: 1px solid #e8ecf1;\n  box-shadow: 0 4px 20px rgba(10, 22, 40, 0.06);\n}\n/* 面板标题 */\n.panel-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 20px;\n  padding-bottom: 14px;\n  border-bottom: 2px solid #f0f2f5;\n}\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.header-title {\n  font-size: 19px;\n  font-weight: 700;\n  color: #1a2a4a;\n  letter-spacing: 1.5px;\n  background: linear-gradient(135deg, #1a2a4a 0%, #2c3e50 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n.header-desc {\n  font-size: 12px;\n  color: #8899aa;\n  font-weight: 500;\n}\n/* Tab切换栏 */\n.tab-bar {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 20px;\n  background: #f5f7fa;\n  border-radius: 10px;\n  padding: 4px;\n}\n.tab-item {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  padding: 10px 16px;\n  border-radius: 8px;\n  cursor: pointer;\n  font-size: 14px;\n  font-weight: 500;\n  color: #778899;\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  border: 1px solid transparent;\n}\n.tab-item:hover {\n  color: #c8161e;\n  background: rgba(200, 22, 30, 0.05);\n}\n.tab-item.tab-active {\n  background: linear-gradient(135deg, #0d1b2a 0%, #152238 100%);\n  color: #ffffff;\n  font-weight: 600;\n  border-color: rgba(200, 22, 30, 0.3);\n  box-shadow: 0 4px 12px rgba(10, 22, 40, 0.2);\n  transform: translateY(-1px);\n}\n.tab-item:active {\n  transform: scale(0.96);\n}\n/* 内容网格 */\n.materials-grid {\n  min-height: 200px;\n}\n/* 分类区块 */\n.material-category {\n  animation: fadeInUp 0.4s ease;\n}\n@keyframes fadeInUp {\n  from {\n    opacity: 0;\n    transform: translateY(10px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n.category-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 12px;\n  padding-bottom: 10px;\n  border-bottom: 1px dashed #e8ecf1;\n}\n.category-title {\n  font-size: 15px;\n  font-weight: 600;\n  color: #1a2a4a;\n}\n/* 资料项列表 */\n.category-items {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n/* 单个资料项 */\n.material-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 14px 16px;\n  border-radius: 10px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n  border: 1px solid transparent;\n  background: #fafbfc;\n  position: relative;\n  overflow: hidden;\n}\n.material-item::before {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  top: 0;\n  height: 100%;\n  width: 3px;\n  background: #c8161e;\n  border-radius: 0 3px 3px 0;\n  transform: scaleY(0);\n  transition: transform 0.3s ease;\n}\n.material-item:hover::before {\n  transform: scaleY(1);\n}\n.material-item:hover {\n  background: #fef5f5;\n  border-color: rgba(200, 22, 30, 0.12);\n  transform: translateX(4px);\n  box-shadow: 0 4px 16px rgba(200, 22, 30, 0.08);\n}\n/* 图标 */\n.item-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 40px;\n  height: 40px;\n  border-radius: 10px;\n  background: rgba(200, 22, 30, 0.06);\n  flex-shrink: 0;\n}\n.material-item:hover .item-icon {\n  background: rgba(200, 22, 30, 0.12);\n  transform: scale(1.05);\n  transition: all 0.3s ease;\n}\n/* 内容 */\n.item-content {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  min-width: 0;\n}\n.item-title {\n  font-size: 14px;\n  font-weight: 600;\n  color: #2c3e50;\n}\n.item-desc {\n  font-size: 12px;\n  color: #8899aa;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n/* 徽章 */\n.item-badge {\n  font-size: 10px;\n  font-weight: 600;\n  color: #ffffff;\n  background: linear-gradient(135deg, #c8161e 0%, #a0121a 100%);\n  padding: 2px 8px;\n  border-radius: 4px;\n  flex-shrink: 0;\n}\n/* 箭头 */\n.item-arrow {\n  flex-shrink: 0;\n  opacity: 0;\n  transition: all 0.3s ease;\n}\n.material-item:hover .item-arrow {\n  opacity: 1;\n  transform: translateX(2px);\n}",
