{"id":"sjvdul3v","css":".score-analysis-page {\n  min-height: 100vh;\n  background: #f8f9fc;\n  font-family: \"Noto Sans SC\", \"PingFang SC\", sans-serif;\n}\n.sa-main {\n  max-width: 1300px;\n  margin: 0 auto;\n  padding: 24px 32px 40px;\n}\n.sa-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 24px;\n}\n.sa-header h2 {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 22px;\n  font-weight: 800;\n  color: #1a2b5f;\n  margin: 0;\n}\n.sa-tabs {\n  display: flex;\n  gap: 4px;\n  background: #ffffff;\n  border-radius: 12px;\n  padding: 4px;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);\n}\n.tab-btn {\n  padding: 10px 24px;\n  border: none;\n  background: transparent;\n  border-radius: 10px;\n  font-size: 14px;\n  font-weight: 700;\n  color: #5a6488;\n  cursor: pointer;\n  transition: all 0.3s;\n}\n.tab-btn.active {\n  background: #1a2b5f;\n  color: #ffffff;\n  box-shadow: 0 2px 8px rgba(26, 43, 95, 0.3);\n}\n.empty-state {\n  text-align: center;\n  padding: 80px 0;\n}\n.empty-illustration {\n  margin-bottom: 20px;\n}\n.empty-icon {\n  font-size: 64px;\n}\n.empty-state h3 {\n  font-size: 20px;\n  color: #1a2b5f;\n  margin: 0 0 8px;\n}\n.empty-state p {\n  color: #8a8faa;\n  margin: 0 0 24px;\n}\n.go-practice-btn {\n  padding: 12px 32px;\n  background: linear-gradient(135deg, #1a2b5f, #1e3470);\n  color: #fff;\n  border: none;\n  border-radius: 12px;\n  cursor: pointer;\n  font-size: 15px;\n  font-weight: 700;\n}\n.sa-content {\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n}\n.chart-card {\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 24px;\n  box-shadow: 0 2px 12px rgba(26, 43, 95, 0.04);\n}\n.card-header {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  margin-bottom: 8px;\n  font-size: 16px;\n  font-weight: 700;\n  color: #1a2b5f;\n}\n.card-sub {\n  font-size: 12px;\n  color: #8a8faa;\n  font-weight: 500;\n}\n.stats-row {\n  display: 