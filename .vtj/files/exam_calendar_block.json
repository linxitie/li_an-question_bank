{
  "id": "exam_calendar_block",
  "css": ".exam-calendar {\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 20px;\n  box-shadow: 0 2px 16px rgba(26, 43, 95, 0.06);\n  max-height: 420px;\n  overflow-y: auto;\n}\n.cal-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 16px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid #f0f2f5;\n}\n.cal-title {\n  font-size: 15px;\n  font-weight: 700;\n  color: #1a2b5f;\n  flex: 1;\n}\n.cal-month {\n  font-size: 12px;\n  color: #8a8faa;\n  background: #f8f9fc;\n  padding: 4px 10px;\n  border-radius: 12px;\n}\n.cal-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.cal-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px 12px;\n  border-radius: 12px;\n  background: #f8f9fc;\n  transition: all 0.3s;\n  cursor: pointer;\n}\n.cal-item:hover {\n  background: #f0f2f5;\n  transform: translateX(2px);\n}\n.cal-date {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  min-width: 44px;\n  padding: 6px;\n  background: #ffffff;\n  border-radius: 10px;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);\n}\n.date-day {\n  font-size: 20px;\n  font-weight: 900;\n  color: #1a2b5f;\n  line-height: 1;\n}\n.date-month {\n  font-size: 10px;\n  color: #8a8faa;\n  margin-top: 2px;\n}\n.cal-content {\n  flex: 1;\n}\n.cal-name {\n  font-size: 13px;\n  font-weight: 600;\n  color: #1a2b5f;\n  margin-bottom: 2px;\n}\n.cal-region {\n  font-size: 11px;\n  color: #8a8faa;\n}\n.cal-status {\n  font-size: 11px;\n  padding: 3px 8px;\n  border-radius: 10px;\n  font-weight: 600;\n}\n.cal-status.upcoming {\n  background: #fff3e0;\n  color: #e65100;\n}\n.cal-status.open {\n  background: #e8f5e9;\n  color: #2e7d32;\n}\n.cal-status.preparing {\n  background: #e3f2fd;\n  color: #1565c0;\n}\n.cal-status.pending {\n  background: #f3e5f5;\n  color: #7b1fa2;\n}\n.cal-status.countdown {\n  background: #fce4ec;\n  color: #c62828;\n}\n.cal-footer {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  margin-top: 16px;\n  padding-top: 12px;\n  border-top: 1px solid #f0f2f5;\n  font-size: 13px;\n  color: #c41e3a;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.3s;\n}\n.cal-footer:hover {\n  color: #e8384f;\n}",
