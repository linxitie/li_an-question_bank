  "css": ".tablet-practice-page{min-height:100vh;background:#f5f7fa;font-family:'PingFang SC','Microsoft YaHei','Noto Sans SC',sans-serif;display:flex;flex-direction:column}.top-nav{display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 24px;background:#ffffff;border-bottom:1px solid #f0f2f5;position:sticky;top:0;z-index:100}.nav-left{display:flex;align-items:center}.logo{display:flex;align-items:center;gap:10px}.logo-text{font-size:20px;font-weight:800;color:#1A365D}.nav-center{flex:1;display:flex;justify-content:center}.page-title{font-size:18px;font-weight:700;color:#1A365D;margin:0}.nav-right{display:flex;align-items:center;gap:16px}.nav-icon{cursor:pointer}.user-avatar{width:36px;height:36px;background:linear-gradient(135deg,#1A365D 0%,#2a5298 100%);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer}.main-content{flex:1;display:grid;grid-template-columns:300px 1fr 280px;gap:20px;padding:20px;overflow:hidden}.left-panel{display:flex;flex-direction:column;gap:16px;overflow-y:auto}.stats-card,.goal-card{background:#ffffff;border-radius:12px;padding:16px;box-shadow:0 2px 8px rgba(26,54,95,0.04)}.card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.card-title{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:600;color:#1a2b5f;margin:0}.stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.stat-item{display:flex;flex-direction:column;align-items:center;padding:16px 8px;background:#f8f9fc;border-radius:10px}.stat-icon{width:40px;height:40px;background:#ffffff;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:8px}.stat-value{font-size:18px;font-weight:700;color:#1A365D;margin-bottom:2px}.stat-label{font-size:11px;color:#8899aa}.progress-info{display:flex;justify-content:space-between;font-size:13px;color:#5a6488;margin-bottom:8px}.progress-percent{font-weight:600;color:#1A365D}.progress-bar{height:8px;background:#f0f2f5;border-radius:4px;overflow:hidden}.progress-fill{height:100%;background:linear-gradient(90deg,#1A365D 0%,#2a5298 100%);border-radius:4px}.center-content{display:flex;flex-direction:column;gap:16px;overflow-y:auto}.quick-actions{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.action-card{display:flex;align-items:center;gap:16px;padding:20px;background:#ffffff;border-radius:12px;box-shadow:0 2px 8px rgba(26,54,95,0.04);cursor:pointer}.action-card:hover{box-shadow:0 4px 16px rgba(26,54,95,0.1);transform:translateY(-2px)}.action-icon{width:56px;height:56px;border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.action-icon.quick{background:linear-gradient(135deg,#1A365D 0%,#2a5298 100%)}.action-icon.weak{background:linear-gradient(135deg,#f59e0b 0%,#d97706 100%)}.action-icon.smart{background:linear-gradient(135deg,#10b981 0%,#059669 100%)}.action-icon.mock{background:linear-gradient(135deg,#8b5cf6 0%,#7c3aed 100%)}.action-info{flex:1;display:flex;flex-direction:column;gap:4px}.action-name{font-size:16px;font-weight:600;color:#1a2b5f}.action-desc{font-size:13px;color:#8899aa}.recent-section{background:#ffffff;border-radius:12px;padding:16px;box-shadow:0 2px 8px rgba(26,54,95,0.04)}.section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.section-title{display:flex;align-items:center;gap:8px;font-size:16px;font-weight:700;color:#1a2b5f;margin:0}.section-action{font-size:13px;color:#1890ff;cursor:pointer}.recent-list{display:flex;flex-direction:column;gap:12px}.recent-item{display:flex;align-items:center;gap:16px;padding:16px;background:#f8f9fc;border-radius:10px;cursor:pointer}.recent-item:hover{background:#f0f2f5}.recent-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.recent-info{flex:1;display:flex;flex-direction:column;gap:4px}.recent-name{font-size:15px;font-weight:600;color:#1a2b5f}.recent-