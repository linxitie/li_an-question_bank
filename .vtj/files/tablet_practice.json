nter;gap:16px}.online-status,.sync-status{display:flex;align-items:center;gap:6px;font-size:12px;color:#5a6488}.version{font-size:12px;color:#8899aa}@media(max-width:1024px){.main-content{grid-template-columns:1fr}.left-panel,.right-panel{display:none}}",
