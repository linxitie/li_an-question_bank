{
  "id": "recruitment_info",
  "css": "/* 招考信息面板 */\n.recruitment-panel {\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 24px;\n  border: 1px solid #e8ecf1;\n  box-shadow: 0 4px 20px rgba(10, 22, 40, 0.06);\n}\n/* 面板标题 */\n.panel-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 20px;\n}\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.header-title {\n  font-size: 19px;\n  font-weight: 700;\n  color: #1a2a4a;\n  letter-spacing: 1.5px;\n  background: linear-gradient(135deg, #1a2a4a 0%, #2c3e50 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n.header-badge {\n  font-size: 11px;\n  color: #c8161e;\n  background: rgba(200, 22, 30, 0.08);\n  padding: 3px 10px;\n  border-radius: 12px;\n  font-weight: 500;\n  position: relative;\n}\n.pulse-dot::before {\n  content: \"\";\n  display: inline-block;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: #c8161e;\n  margin-right: 4px;\n  animation: pulse-dot 2s ease-in-out infinite;\n}\n@keyframes pulse-dot {\n  0%, 100% {\n    opacity: 1;\n    transform: scale(1);\n  }\n  50% {\n    opacity: 0.4;\n    transform: scale(1.5);\n  }\n}\n/* 招考卡片网格 */\n.recruitment-grid {\n  display: grid;\n  grid-template-columns: repeat(6, 1fr);\n  gap: 12px;\n  margin-bottom: 16px;\n}\n@media (max-width: 1200px) {\n  .recruitment-grid {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n/* 单个招考卡片 */\n.recruitment-card {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 10px;\n  padding: 18px 12px 0;\n  border-radius: 12px;\n  background: #fafbfc;\n  border: 1px solid #eef1f5;\n  cursor: pointer;\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  position: relative;\n  overflow: hidden;\n  text-align: center;\n}\n.recruitment-card:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 8px 28px rgba(10, 22, 40, 0.1);\n  border-color: rgba(200, 22, 30, 0.2);\n  background: #fef5f5;\n}\n.recruitment-card:active {\n  transform: scale(0.96);\n}\n/* 图标区域 */\n.card-icon-area {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.card-icon-circle {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 50px;\n  height: 50px;\n  border-radius: 50%;\n  background: rgba(10, 22, 40, 0.04);\n  transition: all 0.3s ease;\n}\n.recruitment-card:hover .card-icon-circle {\n  transform: scale(1.08);\n  background: rgba(200, 22, 30, 0.08);\n}\n/* 新消息徽章 */\n.card-badge {\n  position: absolute;\n  top: -8px;\n  right: -12px;\n  background: linear-gradient(135deg, #c8161e 0%, #a0121a 100%);\n  color: #ffffff;\n  font-size: 9px;\n  font-weight: 600;\n  padding: 2px 6px;\n  border-radius: 8px;\n  box-shadow: 0 2px 8px rgba(200, 22, 30, 0.3);\n  white-space: nowrap;\n  animation: badge-bounce 2s ease-in-out infinite;\n}\n@keyframes badge-bounce {\n  0%, 100% {\n    transform: translateY(0);\n  }\n  50% {\n    transform: translateY(-2px);\n  }\n}\n/* 卡片内容 */\n.card-body {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n  padding-bottom: 12px;\n}\n.card-title {\n  font-size: 13px;\n  font-weight: 600;\n  color: #2c3e50;\n}\n.card-subtitle {\n  font-size: 11px;\n  color: #8899aa;\n}\n/* 状态条 */\n.card-status-bar {\n  height: 3px;\n  width: 100%;\n  border-radius: 0 0 12px 12px;\n  opacity: 0.6;\n  transition: opacity 0.3s ease;\n}\n.recruitment-card:hover .card-status-bar {\n  opacity: 1;\n}\n/* 快捷链接 */\n.quick-links {\n  display: flex;\n  justify-content: center;\n  gap: 20px;\n  padding-top: 12px;\n  border-top: 1px solid #f0f2f5;\n}\n.quick-link-item {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  cursor: pointer;\n  color: #8899aa;\n  font-size: 12px;\n  transition: all 0.25s ease;\n}\n.quick-link-item:hover {\n  color: #c8161e;\n  transform: translateX(2px);\n}\n.quick-link-item span {\n  border-bottom: 1px dashed transparent;\n  transition: border-color 0.25s ease;\n}\n.quick-link-item:hover span {\n  border-bottom-color: #c8161e;\n}",
