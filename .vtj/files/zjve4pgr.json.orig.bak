  "props": [],
  "slots": [],
  "state": {
    "goals": {
      "type": "JSExpression",
      "value": "[]"
    },
    "progress": {
      "type": "JSExpression",
      "value": "65"
    },
    "progressOffset": {
      "type": "JSExpression",
      "value": "0"
    }
  },
  "watch": [],
  "expose": [],
  "inject": [],
  "locked": false,
  "methods": {
    "initGoals": {
      "type": "JSFunction",
      "value": "() => {\n  this.state.goals = [\n    { text: '每日做题100道', current: 78, total: 100, done: false },\n    { text: '每周申论写作3篇', current: 2, total: 3, done: false },\n    { text: '本月行测模拟5次', current: 3, total: 5, done: false },\n    { text: '公安基础背诵3章', current: 3, total: 3, done: true }\n  ];\n  this.updateProgress();\n}"
    },
    "handleEdit": {
      "type": "JSFunction",
      "value": "() => {\n  this.$emit('edit-goal');\n}"
    },
    "toggleGoal": {
      "type": "JSFunction",
      "value": "(index) => {\n  this.state.goals[index].done = !this.state.goals[index].done;\n  this.updateProgress();\n}"
    },
    "updateProgress": {
      "type": "JSFunction",
      "value": "() => {\n  const doneCount = this.state.goals.filter((g) => g.done).length;\n  this.state.progress = Math.round((doneCount / this.state.goals.length) * 100);\n  this.state.progressOffset =\n    this.circumference.value - (this.state.progress / 100) * this.circumference.value;\n}"
    }
  },
  "computed": {
    "dashArray": {
      "type": "JSFunction",
      "value": "() => {\n  return this.circumference.value;\n}"
    },
    "circumference": {
      "type": "JSFunction",
      "value": "() => {\n  return 2 * Math.PI * 42;\n}"
    }
  },
  "lifeCycles": {
    "mounted": {
      "type": "JSFunction",
      "value": "() => {\n  this.initGoals();\n}"
    }
  },
  "__VERSION__": "1778917924916",
  "dataSources": {},
  "__VTJ_BLOCK__": true
