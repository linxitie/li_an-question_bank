{
  "id": "zjve4pgr",
  "css": ".goal-card {\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 20px;\n  box-shadow: 0 2px 16px rgba(26, 43, 95, 0.06);\n  transition: all 0.3s;\n}\n.goal-card:hover {\n  box-shadow: 0 4px 20px rgba(26, 43, 95, 0.1);\n}\n.goal-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 16px;\n}\n.goal-title {\n  font-size: 15px;\n  font-weight: 700;\n  color: #1a2b5f;\n  flex: 1;\n}\n.edit-btn {\n  width: 28px;\n  height: 28px;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: all 0.3s;\n}\n.edit-btn:hover {\n  background: #f0f2f5;\n}\n.goal-content {\n  display: flex;\n  gap: 20px;\n  align-items: center;\n}\n.goal-progress-ring {\n  position: relative;\n  width: 90px;\n  height: 90px;\n  flex-shrink: 0;\n}\n.goal-progress-ring svg {\n  width: 100%;\n  height: 100%;\n}\n.ring-text {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  text-align: center;\n}\n.ring-percent {\n  font-size: 20px;\n  font-weight: 900;\n  color: #1a2b5f;\n  display: block;\n  line-height: 1;\n}\n.ring-label {\n  font-size: 10px;\n  color: #8a8faa;\n  margin-top: 2px;\n}\n.goal-info {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.goal-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.goal-check {\n  width: 20px;\n  height: 20px;\n  border-radius: 6px;\n  border: 2px solid #e0e3e8;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: all 0.3s;\n  font-size: 12px;\n  color: #fff;\n  flex-shrink: 0;\n}\n.goal-check.done {\n  background: #22c55e;\n  border-color: #22c55e;\n}\n.goal-text {\n  font-size: 12px;\n  color: #1a2b5f;\n  font-weight: 500;\n  flex: 1;\n}\n.goal-text.done {\n  color: #22c55e;\n  text-decoration: line-through;\n}\n.goal-count {\n  font-size: 11px;\n  color: #8a8faa;\n  font-weight: 600;\n}",
  "name": "GoalCard",
