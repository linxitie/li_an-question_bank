    "sourceFilter": "''",
    "categoryFilter": "''",
    "currentPage": "1",
    "pageSize": "20",
    "totalItems": "0",
    "totalPages": "1",
    "showDetailModal": "false",
    "selectedNews": "{}",
    "isFavorited": "false",
    "notes": "[]",
    "selectionMenuVisible": "false",
    "selectionMenuPos": "{ x: 0, y: 0 }",
    "selectedText": "''",
    "highlightColor": "'#FFD700'",
    "lineStyle": "'wavy'",
    "showHint": "false",
    "noteInputVisible": "false",
    "noteText": "''"
  },
  "watch": [],
  "expose": [],
  "inject": [],
  "locked": false,
  "methods": {
    "setSourceFilter": {
      "type": "asyncMethod",
      "params": [
        "val"
      ]
    },
    "setCategoryFilter": {
      "type": "JSFunction",
      "value": "async (val) => {\n  this.state.categoryFilter = val;\n  this.state.currentPage = 1;\n  await this.fetchNews();\n}"
    },
    "goPage": {
      "type": "JSFunction",
      "value": "async (page) => {\n  if (page < 1 || page > this.state.totalPages) return;\n  this.state.currentPage = page;\n  await this.fetchNews();\n}"
    },
    "openDetail": {
      "type": "JSFunction",
      "value": "(item) => {\n  this.state.selectedNews = item;\n  this.state.showDetailModal = true;\n  this.state.isFavorited = item.is_favorited || false;\n  this.state.notes = [];\n  this.state.selectionMenuVisible = false;\n  this.fetchNotes(item.id);\n}"
    },
    "closeDetail": {
      "type": "JSFunction",
      "value": "() => {\n  this.state.showDetailModal = false;\n  this.state.selectedNews = {};\n  this.state.isFavorited = false;\n  this.state.notes = [];\n  this.state.selectionMenuVisible = false;\n}"
    },
    "fetchNews": {
      "type": "JSFunction",
      "value": "async () => {\n  this.state.loading = true;\n  try {\n    let url = '/api/news?limit=50';\n    if (this.state.sourceFilter) url += '&source=' + this.state.sourceFilter;\n    if (this.state.categoryFilter) url += '&category=' + this.state.categoryFilter;\n    const res = await window.__VTJ_AUTH__.apiFetch(url);\n    const data = await res.json();\n    if (res.ok && data.items) {\n      this.state.totalItems = data.total;\n      const start = (this.state.currentPage - 1) * this.state.pageSize;\n      this.state.newsItems = data.items.slice(start, start + this.state.pageSize);\n      this.state.totalPages = Math.ceil(data.total / this.state.pageSize) || 1;\n    }\n  } catch (e) {\n    console.error('获取新闻失败:', e);\n  } finally {\n    this.state.loading = false;\n  }\n}"
    },
    "renderContent": {
      "type": "JSFunction",
      "value": "(content) => {\n  if (!content) return '';\n  const paragraphs = content.split(/\\n{2,}/);\n  let html = '';\n  for (const para of paragraphs) {\n    if (para.trim()) {\n      const escaped = para.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n      const withBreaks = escaped.replace(/\\n/g, '<br/>');\n      html += '<p style=\"margin-bottom:16px;text-indent:2em;\">' + withBreaks + '</p>';\n    }\n  }\n  return html;\n}"
    },
    "handleTextSelection": {
      "type": "JSFunction",
      "value": "() => {\n  const sel = window.getSelection();\n  const text = (sel && sel.toString() || '').trim();\n  if (text.length > 0) {\n    this.state.selectedText = text;\n    const range = sel.getRangeAt(0);\n    const rect = range.getBoundingClientRect();\n    this.state.selectionMenuPos = { x: rect.left + rect.width / 2 - 60, y: rect.top - 40 + window.scrollY };\n    this.state.selectionMenuVisible = true;\n  } else {\n    this.state.selectionMenuVisible = false;\n    this.state.selectedText = '';\n  }\n}"
    },
    "applyHighlight": {
      "type": "asyncMethod",
      "params": [
        "color"
      ],
      "value": "async (color) => {\n  if (!this.state.selectedText) return;\n  if (color) this.state.highlightColor = color;\n  const newsId = this.state.selectedNews.id;\n  try {\n    await window.__VTJ_AUTH__.apiFetch('/api/news/' + newsId + '/note', {\n      method: 'POST', headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ note_text: '', quote_text: this.state.selectedText, color: this.state.highlightColor, line_style: this.state.lineStyle })\n    });\n    this.state.selectionMenuVisible = false;\n    this.state.selectedText = '';\n    await this.fetchNotes(newsId);\n  } catch (e) { console.error('划线失败:', e); }\n}"
    },
    "toggleCardFavorite": {
      "type": "asyncMethod",
      "params": [
        "item"
      ],
      "value": "async (item) => {\n  try {\n    const res = await window.__VTJ_AUTH__.apiFetch('/api/news/' + item.id + '/favorite', { method: 'POST' });\n    const data = await res.json();\n    item.is_favorited = data.favorited;\n  } catch (e) { console.error('收藏失败:', e); }\n}"
    },
    "renderNoteStyle": {
      "type": "method",
      "params": [
        "note"
      ],
      "value": "(note) => {\n  const color = note.color || '#FFD700';\n  const style = note.line_style || 'wavy';\n  if (style === 'marker') {\n    return { backgroundColor: color + '40', padding: '0 2px', borderRadius: '2px' };\n  } else if (style === 'straight') {\n    return { textDecoration: 'underline', textDecorationColor: color, textUnderlineOffset: '4px' };\n  } else {\n    return { textDecoration: 'underline wavy', textDecorationColor: color, textUnderlineOffset: '4px' };\n  }\n}"
    },
    "scrollToNotes": {
      "type": "method",
      "params": []
    },
    "resolveImgUrl": {
      "type": "method",
      "params": [
        "url"
      ]
    },
    "hasInlineMarkers": {
      "type": "method",
      "params": [
        "content"
      ]
    },
    "setLineStyle": {
      "type": "method",
      "params": [
        "style"
      ]
    },
    "openNoteInput": {
      "type": "method",
      "params": []
    },
    "cancelNoteInput": {
      "type": "method",
      "params": []
    },
    "saveNoteOnBlur": {
      "type": "asyncMethod",
      "params": []
    },
    "toggleFavorite": {
      "type": "JSFunction",
      "value": "async () => {\n  const newsId = this.state.selectedNews.id;\n  try {\n    const res = await window.__VTJ_AUTH__.apiFetch('/api/news/' + newsId + '/favorite', { method: 'POST' });\n    const data = await res.json();\n    this.state.isFavorited = data.favorited;\n  } catch (e) { console.error('收藏操作失败:', e); }\n}"
    },
    "fetchNotes": {
      "type": "JSFunction",
      "value": "async (newsId) => {\n  try {\n    const res = await window.__VTJ_AUTH__.apiFetch('/api/news/' + newsId + '/notes');\n    const data = await res.json();\n    if (res.ok) { this.state.notes = data.items || []; }\n  } catch (e) { console.error('获取笔记失败:', e); }\n}"
    },
    "removeNote": {
      "type": "JSFunction",
      "value": "async (noteId) => {\n  try {\n    await window.__VTJ_AUTH__.apiFetch('/api/news/notes/' + noteId, { method: 'DELETE' });\n    this.state.notes = this.state.notes.filter(n => n.note_id !== noteId);\n  } catch (e) { console.error('删除笔记失败:', e); }\n}"
    }
  },
