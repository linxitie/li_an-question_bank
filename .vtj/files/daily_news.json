{
  "id": "daily_news",
  "name": "DailyNews",
  "css": ".news-page {\n  min-height: 100vh;\n  background: linear-gradient(180deg, #f8f9fc 0%, #f1f3f8 100%);\n  font-family: \"Noto Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n}\n.news-container {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 32px 40px;\n}\n.news-page-header {\n  text-align: center;\n  padding: 40px 0 20px;\n}\n.news-page-title {\n  font-size: 32px;\n  font-weight: 900;\n  color: #1a2b5f;\n  margin: 0;\n  letter-spacing: 4px;\n}\n.news-page-subtitle {\n  font-size: 14px;\n  color: #8a8faa;\n  margin: 8px 0 0;\n}\n/* 筛选标签 */\n.filter-bar {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 16px;\n  margin-bottom: 24px;\n  padding: 20px;\n  background: #ffffff;\n  border-radius: 16px;\n  box-shadow: 0 2px 12px rgba(26,43,95,0.05);\n}\n.filter-group {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.filter-label {\n  font-size: 13px;\n  font-weight: 700;\n  color: #5a6488;\n  margin-right: 4px;\n}\n.filter-tag {\n  padding: 6px 16px;\n  border-radius: 20px;\n  font-size: 13px;\n  cursor: pointer;\n  transition: all 0.3s;\n  border: none;\n  background: #f1f3f8;\n  color: #5a6488;\n  font-weight: 500;\n}\n.filter-tag:hover { background: #e8eaf0; color: #1a2b5f; }\n.filter-tag.active { background: #c41e3a; color: #ffffff; font-weight: 700; }\n/* 新闻列表 */\n.news-list-container {\n  background: #ffffff;\n  border-radius: 16px;\n  box-shadow: 0 2px 12px rgba(26,43,95,0.05);\n  overflow: hidden;\n}\n.news-list-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 20px 24px;\n  border-bottom: 1px solid #f0f2f5;\n}\n.news-count {\n  font-size: 14px;\n  color: #8a8faa;\n}\n.news-count strong { color: #c41e3a; font-size: 16px; }\n.news-card {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 18px 24px;\n  border-bottom: 1px solid #f8f9fc;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n.news-card:hover { background: #f8f9fc; }\n.news-card:last-child { border-bottom: none; }\n.news-card-index {\n  width: 28px;\n  height: 28px;\n  border-radius: 8px;\n  background: #f1f3f8;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 12px;\n  font-weight: 700;\n  color: #8a8faa;\n  flex-shrink: 0;\n}\n.news-card:nth-child(-n+3) .news-card-index { background: #fef0f2; color: #c41e3a; }\n.news-card-body { flex: 1; min-width: 0; }\n.news-card-title {\n  font-size: 15px;\n  font-weight: 600;\n  color: #1a2b5f;\n  margin: 0 0 6px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.news-card-meta {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  font-size: 12px;\n  color: #8a8faa;\n}\n.news-source-badge {\n  padding: 2px 8px;\n  border-radius: 6px;\n  font-size: 11px;\n  font-weight: 600;\n}\n.badge-cpd { background: #fef0f2; color: #c41e3a; }\n.badge-people { background: #eff6ff; color: #2563eb; }\n.news-card-arrow { color: #c9cdd8; font-size: 16px; flex-shrink: 0; }\n/* 分页 */\n.pagination-bar {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 20px;\n}\n.page-btn {\n  padding: 8px 14px;\n  border-radius: 8px;\n  border: 1px solid #e8eaf0;\n  background: #ffffff;\n  color: #5a6488;\n  font-size: 13px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n.page-btn:hover:not(:disabled) { background: #f1f3f8; color: #1a2b5f; }\n.page-btn:disabled { opacity: 0.4; cursor: not-allowed; }\n.page-btn.active { background: #c41e3a; border-color: #c41e3a; color: #ffffff; font-weight: 700; }\n.page-info { font-size: 12px; color: #8a8faa; margin: 0 8px; }\n/* 空状态 */\n.empty-state {\n  text-align: center;\n  padding: 60px 20px;\n}\n.empty-state p { font-size: 14px; color: #8a8faa; margin: 0; }\n/* 加载状态 */\n.loading-state {\n  text-align: center;\n  padding: 60px 20px;\n}\n.loading-state p { font-size: 14px; color: #8a8faa; margin: 0; }\n/* 弹窗 */\n.news-modal-overlay {\n  position: fixed; top: 0; left: 0; right: 0; bottom: 0;\n  background: rgba(0,0,0,0.5); display: flex; align-items: center;\n  justify-content: center; z-index: 1000;\n}\n.news-modal {\n  background: #ffffff; border-radius: 16px; width: 90%; max-width: 1200px;\n  max-height: 85vh; display: flex; flex-direction: column;\n  box-shadow: 0 8px 40px rgba(26,43,95,0.15); overflow: hidden;\n  padding: 32px 40px;\n}\n.news-modal-header {\n  display: flex; align-items: flex-start; justify-content: space-between;\n  padding: 0 0 16px; border-bottom: 1px solid #f0f2f5;\n}\n.news-modal-title {\n  font-size: 20px; font-weight: 700; color: #1a2b5f;\n  margin: 0; line-height: 1.5; flex: 1; padding-right: 12px;\n}\n.news-modal-close {\n  width: 32px; height: 32px; border: none; background: #f8f9fc;\n  border-radius: 8px; cursor: pointer; font-size: 18px; color: #8a8faa;\n  display: flex; align-items: center; justify-content: center; flex-shrink: 0;\n}\n.news-modal-close:hover { background: #f0f2f5; color: #1a2b5f; }\n.news-modal-meta {\n  display: flex; align-items: center; gap: 12px;\n  padding: 12px 0; border-bottom: 1px solid #f8f9fc;\n}\n.news-modal-body {\n  padding: 20px 0; overflow-y: auto; flex: 1; max-height: 55vh;\n}\n.news-modal-content {\n  font-size: 15px; line-height: 1.8; color: #33375a;\n  margin: 0;\n}\n.news-modal-content p {\n  margin-bottom: 16px; line-height: 1.9;\n}\n.news-modal-content p:last-child { margin-bottom: 0; }\n.news-modal-images {\n  display: flex; flex-direction: column; gap: 16px;\n  padding: 0; margin: 20px 0;\n}\n.news-content-img {\n  max-width: 100%; border-radius: 8px; height: auto;\n  margin: 12px auto; display: block;\n}\n.news-modal-footer {\n  display: flex; justify-content: flex-end; gap: 12px;\n  padding: 16px 0 0; border-top: 1px solid #f0f2f5;\n}\n.news-modal-link {\n  padding: 8px 16px; border-radius: 8px; font-size: 13px;\n  text-decoration: none; color: #5a6488; background: #f8f9fc;\n}\n.news-modal-link:hover { background: #f0f2f5; color: #1a2b5f; }\n.news-modal-btn {\n  padding: 8px 20px; border: none; background: #c41e3a;\n  color: #ffffff; border-radius: 8px; font-size: 13px;\n  font-weight: 600; cursor: pointer;\n}\n.news-modal-btn:hover { background: #a0182e; }",
