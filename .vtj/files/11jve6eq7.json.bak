  "state": {
    "quote": {
      "type": "JSExpression",
      "value": "'忠诚是公安队伍代代相传的政治基因，是融入血脉的人民警察之魂。'"
    },
    "author": {
      "type": "JSExpression",
      "value": "'人民公安报'"
    },
    "currentDate": {
      "type": "JSExpression",
      "value": "''"
    },
    "showNewsModal": {
      "type": "JSExpression",
      "value": "false"
    },
    "selectedNews": {
      "type": "JSExpression",
      "value": "({})"
    }
  },
