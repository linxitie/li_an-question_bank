{
  "id": "11jve6eq7",
  "css": ".quote-banner {\n  background: linear-gradient(135deg, #ffffff 0%, #fdfdff 100%);\n  border-radius: 16px;\n  padding: 24px 28px;\n  box-shadow: 0 2px 16px rgba(26, 43, 95, 0.06);\n  position: relative;\n  overflow: hidden;\n  border-left: 4px solid #c41e3a;\n}\n.quote-decoration {\n  position: absolute;\n  top: -30px;\n  right: -30px;\n  width: 100px;\n  height: 100px;\n  background: radial-gradient(circle, rgba(196, 30, 58, 0.04) 0%, transparent 70%);\n  border-radius: 50%;\n}\n.quote-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 14px;\n}\n.quote-source {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 13px;\n  font-weight: 600;\n  color: #1a2b5f;\n}\n.quote-date {\n  font-size: 11px;\n  color: #8a8faa;\n  background: #f8f9fc;\n  padding: 2px 10px;\n  border-radius: 10px;\n}\n.quote-body {\n  position: relative;\n  padding: 8px 0;\n}\n.quote-text {\n  font-size: 15px;\n  line-height: 1.8;\n  color: #33375a;\n  font-weight: 500;\n  letter-spacing: 0.5px;\n  font-family: \"Noto Serif SC\", \"STSong\", \"Songti SC\", serif;\n}\n.quote-mark {\n  font-size: 48px;\n  color: rgba(196, 30, 58, 0.12);\n  font-family: Georgia, serif;\n  line-height: 1;\n}\n.left-mark {\n  position: absolute;\n  top: -10px;\n  left: -4px;\n}\n.right-mark {\n  position: absolute;\n  bottom: -20px;\n  right: 0;\n}\n.quote-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: 12px;\n}\n.quote-author {\n  font-size: 12px;\n  color: #8a8faa;\n  font-style: italic;\n}\n.refresh-btn {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  padding: 6px 12px;\n  border: none;\n  background: #fef0f2;\n  color: #c41e3a;\n  border-radius: 14px;\n  font-size: 12px;\n  cursor: pointer;\n  transition: all 0.3s;\n  font-weight: 500;\n}\n.refresh-btn:hover {\n  background: #fde2e6;\n  transform: scale(1.02);\n}",
  "name": "QuoteBanner",
