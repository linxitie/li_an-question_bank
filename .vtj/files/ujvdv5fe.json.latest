ession", "value": "false"}, "currentIndex": {"type": "JSExpression", "value": "0"}, "optionLabels": {"type": "JSExpression", "value": "['A', 'B', 'C', 'D', 'E', 'F']"}, "sheetVisible": {"type": "JSExpression", "value": "false"}, "markedQuestions": {"type": "JSExpression", "value": "[]"}}, "watch": [], "expose": [], "inject": [], "locked": false, "methods": {"isCorrect": {"type": "JSFunction", "value": "(q) => {\n  var userChoice = this.state.answers[q.id];\n  if (userChoice === undefined || userChoice === null) return false;\n  if (q.type === '多选' || q.type === '多选题') {\n    if (!Array.isArray(userChoice)) return false;\n    var self = this;\n    var userLetters = userChoice.map(function(idx) { return self.state.optionLabels[idx]; }).sort().join('');\n    var correctLetters = (q.answer || '').split('').sort().join('');\n    return userLetters === correctLetters;\n  }\n  var userLetter = this.state.optionLabels[userChoice];\n  return userLetter === q.answer;\n}"}, "formatTime": {"type": "JSFunction", "value": "(seconds) => {\n  const h = Math.floor(seconds / 3600);\n  const m = Math.floor((seconds % 3600) / 60);\n  const s = seconds % 60;\n  return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;\n}"}, "handleExit": {"type": "JSFunction", "value": "() => {\n  this.$router.back();\n}"}, "startTimer": {"type": "JSFunction", "value": "() => {\n  this._timer = setInterval(() => {\n    if (this.state.timeLeft > 0) {\n      this.state.timeLeft--;\n    } else {\n      this.handleSubmit();\n    }\n  }, 1000);\n}"}, "toggleMark": {"type": "JSFunction", "value": "(qId) => {\n  const idx = this.state.markedQuestions.indexOf(qId);\n  if (idx >= 0) {\n    this.state.markedQuestions.splice(idx, 1);\n  } else {\n    this.state.markedQuestions.push(qId);\n  }\n}"}, "handleSubmit": {"type": "JSFunction", "value": "() => {\n  this.state.showResult = true;\n  this.$message.success('试卷已提交');\n  this.submitPracticeRecords();\n  this.triggerCheckin();\n}"}, "selectOption": {"type": "JSFunction", "value": "(qId, oidx, type) => {\n  if (this.state.showResult) return;\n  if (type === '多选' || type === '多选题' || type === '不定项') {\n    var current = this.state.answers[qId] || [];\n    if (current.includes(oidx)) {\n      this.state.answers[qId] = current.filter(function(o) { return o !== oidx; });\n    } else {\n      this.state.answers[qId] = current.concat([oidx]);\n    }\n  } else {\n    this.state.answers[qId] = oidx;\n  }\n}"}, "loadQuestions": {"type": "JSFunction", "value": "() => {\n  this.state.questions = [];\n  this.ensureLogin().then(() => {\n    const headers = this.getJsonHeaders();\n    let params = new URLSearchParams({ count: 20 });\n    fetch('/api/questions/random?' + params.toString(), {\n      method: 'GET', headers: headers\n    }).then(res => res.json()).then(data => {\n      if (data.questions && data.questions.length) {\n        this.state.questions = data.questions.map(q => {\n          var rawOpts = q.options;\n          var parsedOpts = [];\n          if (rawOpts) {\n            if (typeof rawOpts === 'string') {\n              try { rawOpts = JSON.parse(rawOpts); } catch(e) { parsedOpts = [rawOpts]; }\n            }\n            if (Array.isArray(rawOpts)) {\n              parsedOpts = rawOpts.map(function(o) {\n                if (typeof o === 'string') return o;\n                if (o && typeof o === 'object') {\n                  var key = (o.key || '');\n                  var text = (o.value || o.text || '');\n                  text = text.replace(/[.。、'；;：:，,！!？?]+$/g, '').trim();\n                  return (key ? key + '. ' : '') + (text || '(空)');\n                }\n                return String(o);\n              });\n            }\n          }\n          if (!parsedOpts.length) parsedOpts = ['(暂无选项)'];\n          parsedOpts = parsedOpts.map(function(opt) {\n            if (typeof opt === 'string') {\n              return opt.replace(/\\[IMAGE:(\\d+)_(\\d+)\\]/g, function(m, qn, idx) {\n                return '<img src=\"/static/questions/' + qn + '_' + idx + '.png\" class=\"q-img\" loading=\"lazy\" onerror=\"this.style.display=none\" />';\n              });\n            }\n            return opt;\n          });\n          var stem = q.question_content || '';\n          stem = stem.replace(/\\n?\\s*[A-H]\\s*[.、．)）]\\s*.+/g, '');\n          stem = stem.replace(/\\[IMAGE:(\\d+)_(\\d+)\\]/g, function(m, qn, idx) {\n            return '<img src=\"/static/questions/' + qn + '_' + idx + '.png\" class=\"q-img\" loading=\"lazy\" onerror=\"this.style.display=none\" />';\n          });\n          stem = stem.trim();\n          return {\n            id: q.question_id,\n            type: (function() {\n              var typeMap = {'单选题':'单选', '选择题':'单选', '单选':'单选', '多选题':'多选', '不定项':'多选', '多选':'多选'};\n              var mapped = typeMap[q.question_type_detail];\n              if (!mapped && q.answer && q.answer.length > 1) mapped = '多选';\n              return mapped || '单选';\n            })(),\n            stem: stem || q.question_content || '',\n            options: parsedOpts,\n            answer: q.answer || '',\n            explain: q.answer_analysis || '暂未提供解析'\n          };\n        });\n      }\n      if (!this.state.questions.length) {\n        this.state.questions = [{id: 0, type: '提示', stem: '题库暂无题目数据', options: [], answer: '', explain: ''}];\n      }\n    }).catch(() => {\n      this.state.questions = [{id: 0, type: '提示', stem: '加载失败，请检查网络连接', options: [], answer: '', explain: ''}];\n    });\n  });\n}"}, "jumpToQuestion": {"type": "JSFunction", "value": "(idx) => {\n  this.state.currentIndex = idx;\n  const el = this.$refs['question_' + this.state.questions[idx].id];\n  if (el && el[0]) {\n    el[0].scrollIntoView({ behavior: 'smooth', block: 'start' });\n  }\n}"}, "isOptionSelected": {"type": "JSFunction", "value": "(qId, oidx) => {\n  const ans = this.state.answers[qId];\n  if (Array.isArray(ans)) return ans.includes(oidx);\n  return ans === oidx;\n}"}, "toggleAnswerSheet": {"type": "JSFunction", "value": "() => {\n  this.state.sheetVisible = !this.state.sheetVisible;\n}"}, "submitPracticeRecords": {"type": "JSFunction", "value": "() => {\n  var self = this;\n  var questions = this.state.questions;\n  for (var i = 0; i < questions.length; i++) {\n    var q = questions[i];\n    var userAns = this.state.answers[q.id];\n    if (userAns === undefined) continue;\n    var userLetter;\n    if (Array.isArray(userAns)) {\n      userLetter = userAns.map(function(idx) { return self.state.optionLabels[idx]; }).sort().join('');\n    } else {\n      userLetter = self.state.optionLabels[userAns] || '';\n    }\n    var correct = (q.type === '多选' || q.type === '多选题') ?\n      (userLetter.split('').sort().join('') === (q.answer || '').split('').sort().join('')) :\n      (userLetter === q.answer);\n    window.__VTJ_AUTH__.apiFetch('/api/practice/record', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({\n        question_id: q.id, subject_id: q.subject_id || null,\n        is_correct: correct, time_spent: 0,\n        user_answer: userLetter, source: '随机练习'\n      })\n    }).catch(function() {});\n  }\n}"}, "triggerCheckin": {"type": "JSFunction", "value": "() => {\n  window.__VTJ_AUTH__.apiFetch('/api/stats/auto-checkin', {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({})\n  }).catch(function() {});\n}"}}, "computed": {"answeredCount": {"type": "JSFunction", "value": "() => {\n  return Object.keys(this.state.answers).length;\n}"}}, "lifeCycles": {"mounted": {"type": "JSFunction", "value": "() => {\n  this.loadQuestions();\n  this.startTimer();\n}"}, "beforeUnmount": {"type": "JSFunction", "value": "() => {\n  if (this._timer) {\n    clearInterval(this._timer);\n    this._timer = null;\n  }\n}"}}, "__VERSION__": "1778918968644", "dataSources": {}, "__VTJ_BLOCK__": true}