{
  "id": "gjv83ley",
  "css": "/* 考试日历卡片 */\n.exam-calendar-card {\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 20px 20px 12px;\n  border: 1px solid #e8ecf1;\n  box-shadow: 0 4px 20px rgba(10, 22, 40, 0.06);\n  transition: all 0.3s ease;\n  height: 100%;\n}\n.exam-calendar-card:hover {\n  box-shadow: 0 6px 28px rgba(10, 22, 40, 0.1);\n}\n/* 卡片标题 */\n.card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 16px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid #f0f2f5;\n}\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.header-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: #1a2a3a;\n  letter-spacing: 1px;\n}\n.header-badge {\n  font-size: 11px;\n  color: #c8161e;\n  background: rgba(200, 22, 30, 0.08);\n  padding: 3px 10px;\n  border-radius: 12px;\n  font-weight: 500;\n}\n/* 考试列表 */\n.exam-list {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n.exam-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px 12px;\n  border-radius: 10px;\n  cursor: pointer;\n  transition: all 0.25s ease;\n  border: 1px solid transparent;\n}\n.exam-item:hover {\n  background: rgba(200, 22, 30, 0.03);\n  border-color: rgba(200, 22, 30, 0.1);\n  transform: translateX(4px);\n}\n/* 日期盒子 */\n.exam-date-box {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  min-width: 48px;\n  height: 48px;\n  background: linear-gradient(135deg, #fef1f2 0%, #fde8ea 100%);\n  border-radius: 10px;\n  border: 1px solid rgba(200, 22, 30, 0.15);\n}\n.exam-month {\n  font-size: 11px;\n  font-weight: 500;\n  color: #c8161e;\n  line-height: 1;\n}\n.exam-day {\n  font-size: 18px;\n  font-weight: 700;\n  color: #c8161e;\n  line-height: 1.2;\n}\n/* 考试信息 */\n.exam-info {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n}\n.exam-title {\n  font-size: 13px;\n  font-weight: 500;\n  color: #2c3e50;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.exam-location {\n  font-size: 11px;\n  color: #8899aa;\n}\n/* 箭头 */\n.exam-arrow {\n  display: flex;\n  align-items: center;\n  opacity: 0;\n  transition: opacity 0.25s ease;\n}\n.exam-item:hover .exam-arrow {\n  opacity: 1;\n}\n/* 底部链接 */\n.card-footer {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  padding: 12px 0 4px;\n  cursor: pointer;\n  border-top: 1px solid #f5f6f8;\n  margin-top: 8px;\n  transition: all 0.25s ease;\n}\n.card-footer:hover {\n  color: #c8161e;\n}\n.footer-link {\n  font-size: 12px;\n  color: #8899aa;\n  font-weight: 500;\n}\n.card-footer:hover .footer-link {\n  color: #c8161e;\n}",
