  "css": ".recruitment-info {\n  background: linear-gradient(135deg, #1a2a3a 0%, #2a3a4a 100%);\n  border-radius: 16px;\n  padding: 20px;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);\n  color: #ffffff;\n  font-family: \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n}\n.block-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 16px;\n}\n.block-title {\n  font-size: 16px;\n  font-weight: 600;\n  letter-spacing: 0.5px;\n}\n.tab-nav {\n  display: flex;\n  gap: 6px;\n  margin-bottom: 16px;\n  overflow-x: auto;\n  padding-bottom: 4px;\n}\n.tab-item {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  padding: 6px 14px;\n  border-radius: 20px;\n  font-size: 13px;\n  font-weight: 500;\n  color: #b0b8c4;\n  background: rgba(255, 255, 255, 0.04);\n  cursor: pointer;\n  transition: all 0.3s ease;\n  white-space: nowrap;\n  border: 1px solid transparent;\n}\n.tab-item:hover {\n  background: rgba(255, 255, 255, 0.08);\n  color: #ffffff;\n}\n.tab-item.active {\n  background: rgba(230, 57, 70, 0.15);\n  color: #e63946;\n  border-color: #e63946;\n  font-weight: 600;\n}\n.tab-badge {\n  background: #e63946;\n  color: #ffffff;\n  font-size: 10px;\n  padding: 1px 6px;\n  border-radius: 10px;\n  font-weight: 600;\n}\n.info-list {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.info-card {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 14px;\n  background: rgba(255, 255, 255, 0.03);\n  border-radius: 10px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n  border: 1px solid rgba(255, 255, 255, 0.05);\n}\n.info-card:hover {\n  background: rgba(255, 255, 255, 0.07);\n  border-color: rgba(230, 57, 70, 0.2);\n  transform: translateX(4px);\n}\n.info-left {\n  display: flex;\n  align-items: center;\n}\n.info-tag {\n  padding: 3px 10px;\n  border-radius: 6px;\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.5px;\n}\n.info-center {\n  flex: 1;\n  min-width: 0;\n}\n.info-title {\n  font-size: 14px;\n  font-weight: 500;\n  color: #d0d8e0;\n  margin-bottom: 4px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.info-meta {\n  font-size: 11px;\n  color: #8898a8;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n.meta-divider {\n  opacity: 0.3;\n}\n.info-right {\n  display: flex;\n  align-items: center;\n}",
