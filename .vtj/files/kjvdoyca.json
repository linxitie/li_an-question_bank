{
  "id": "kjvdoyca",
  "css": ".countdown-wrapper {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 20px 24px;\n  background: linear-gradient(135deg, #f8f9fc 0%, #ffffff 100%);\n  border-radius: 16px;\n  box-shadow: 0 2px 16px rgba(26, 43, 95, 0.06);\n  position: relative;\n  overflow: hidden;\n}\n.countdown-wrapper::before {\n  content: \"\";\n  position: absolute;\n  top: -40px;\n  right: -40px;\n  width: 120px;\n  height: 120px;\n  background: radial-gradient(circle, rgba(196, 30, 58, 0.06) 0%, transparent 70%);\n  border-radius: 50%;\n}\n.countdown-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 16px;\n}\n.header-title {\n  font-size: 16px;\n  font-weight: 700;\n  color: #1a2b5f;\n  letter-spacing: 2px;\n  font-family: \"PingFang SC\", \"Microsoft YaHei\", \"Helvetica Neue\", sans-serif;\n}\n.countdown-display {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  flex-wrap: wrap;\n  justify-content: center;\n}\n.time-block {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  background: linear-gradient(180deg, #1a2b5f 0%, #152350 100%);\n  border-radius: 10px;\n  padding: 8px 10px;\n  min-width: 48px;\n  box-shadow: 0 4px 12px rgba(26, 43, 95, 0.25);\n  position: relative;\n  overflow: hidden;\n}\n.time-block::after {\n  content: \"\";\n  position: absolute;\n  top: 50%;\n  left: 0;\n  right: 0;\n  height: 1px;\n  background: rgba(255, 255, 255, 0.1);\n}\n.time-number {\n  font-size: 28px;\n  font-weight: 900;\n  color: #ffffff;\n  font-family: \"SF Pro Display\", \"DIN Alternate\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  line-height: 1;\n  text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);\n  letter-spacing: 2px;\n}\n.time-label {\n  font-size: 11px;\n  color: rgba(255, 255, 255, 0.7);\n  margin-top: 4px;\n  font-weight: 500;\n  letter-spacing: 1px;\n}\n.time-separator {\n  font-size: 22px;\n  font-weight: 700;\n  color: #c41e3a;\n  animation: blink 1s ease-in-out infinite;\n}\n@keyframes blink {\n  0%, 100% {\n    opacity: 1;\n  }\n  50% {\n    opacity: 0.3;\n  }\n}\n.countdown-subtitle {\n  margin-top: 12px;\n  font-size: 13px;\n  color: #5a6488;\n  letter-spacing: 1px;\n  font-weight: 500;\n}",
