  "methods": {
    "startTimer": {
      "type": "JSFunction",
      "value": "() => {\n  this.calculateCountdown();\n  this._timer = setInterval(() => {\n    this.calculateCountdown();\n  }, 1000);\n}"
    },
    "calculateCountdown": {
      "type": "JSFunction",
      "value": "() => {\n  const target = new Date(this.props.targetDate).getTime();\n  const now = Date.now();\n  let diff = target - now;\n  if (diff <= 0) {\n    this.state.year = 0;\n    this.state.month = 0;\n    this.state.day = 0;\n    this.state.hour = 0;\n    this.state.minute = 0;\n    this.state.second = 0;\n    return;\n  }\n  const totalSeconds = Math.floor(diff / 1000);\n  this.state.second = totalSeconds % 60;\n  const totalMinutes = Math.floor(totalSeconds / 60);\n  this.state.minute = totalMinutes % 60;\n  const totalHours = Math.floor(totalMinutes / 60);\n  this.state.hour = totalHours % 24;\n  const totalDays = Math.floor(totalHours / 24);\n  this.state.year = Math.floor(totalDays / 365);\n  const remainingDays = totalDays % 365;\n  this.state.month = Math.floor(remainingDays / 30);\n  this.state.day = remainingDays % 30;\n}"
    }
  },
  "computed": {},
  "lifeCycles": {
    "mounted": {
      "type": "JSFunction",
      "value": "() => {\n  this.startTimer();\n}"
    },
    "beforeUnmount": {
      "type": "JSFunction",
      "value": "() => {\n  if (this._timer) {\n    clearInterval(this._timer);\n    this._timer = null;\n  }\n}"
    }
  },
