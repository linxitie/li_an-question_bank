  "css": ".dl-page{min-height:100vh;background:linear-gradient(180deg,#f8f9fc 0%,#f1f3f8 100%);font-family:'Noto Sans SC','PingFang SC','Microsoft YaHei',sans-serif}.dl-main{max-width:1100px;margin:0 auto;padding:24px 32px 40px}.dl-hero{text-align:center;padding:60px 20px 40px;position:relative;margin-bottom:40px}.hero-bg{position:absolute;top:0;left:50%;transform:translateX(-50%);width:400px;height:400px;background:radial-gradient(circle,rgba(196,30,58,0.08) 0%,transparent 70%);border-radius:50%}.hero-content{position:relative;z-index:1}.hero-title{font-size:42px;font-weight:900;color:#1a2b5f;margin:0;letter-spacing:3px}.hero-subtitle{font-size:18px;color:#5a6488;margin:12px 0 8px}.hero-desc{font-size:14px;color:#8a8faa}.dl-scan-area{display:flex;gap:40px;justify-content:center;align-items:flex-start;margin-bottom:48px;flex-wrap:wrap}.qr-panel{background:#fff;border-radius:24px;padding:32px;box-shadow:0 4px 24px rgba(26,43,95,0.08);text-align:center;width:320px;flex-shrink:0}.qr-container{width:256px;height:256px;margin:0 auto 20px;border-radius:16px;border:2px solid #e8eaf0;display:flex;align-items:center;justify-content:center;background:#f8f9fc;overflow:hidden;position:relative}.qr-image{width:100%;height:100%;object-fit:contain}.qr-loading{display:flex;flex-direction:column;align-items:center;gap:8px;color:#8a8faa;font-size:14px}.spinner{width:32px;height:32px;border:3px solid #e8eaf0;border-top-color:#c41e3a;border-radius:50%;animation:spin 0.8s linear infinite}.qr-overlay{position:absolute;inset:0;background:rgba(255,255,255,0.9);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;border-radius:14px}.expired-icon{font-size:48px;opacity:0.4}.expired-text{font-size:14px;color:#8a8faa;margin:0}.expired-sub{font-size:12px;color:#c0c4cc;margin:0}.refresh-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 20px;border:none;border-radius:10px;background:linear-gradient(135deg,#1a365f,#2a5298);color:#fff;font-size:13px;font-weight:600;cursor:pointer;transition:all 0.3s;box-shadow:0 2px 8px rgba(26,54,95,0.2)}.refresh-btn:hover{transform:scale(1.03);box-shadow:0 4px 12px rgba(26,54,95,0.3)}.qr-status{margin-top:16px;font-size:13px;color:#5a6488}.status-pending .countdown{color:#c41e3a;font-weight:700}.status-confirmed{color:#52c41a;font-weight:600}.status-expired{color:#c41e3a}.switch-login{margin-top:20px;padding-top:16px;border-top:1px solid #f0f2f5}.switch-login a{font-size:14px;color:#1a365f;text-decoration:none;font-weight:600;cursor:pointer;transition:color 0.2s}.switch-login a:hover{color:#c41e3a}.info-panel{flex:1;max-width:420px;padding-top:8px}.info-panel h3{font-size:20px;font-weight:800;color:#1a2b5f;margin:0 0 24px}.step-list{list-style:none;padding:0;margin:0 0 32px}.step-list li{display:flex;align-items:flex-start;gap:16px;padding:14px 0;border-bottom:1px solid #f0f2f5}.step-list li:last-child{border-bottom:none}.step-num{width:32px;height:32px;border-radius:10px;background:linear-gradient(135deg,#c41e3a,#e8384f);color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;flex-shrink:0}.step-text{flex:1}.step-text strong{display:block;font-size:15px;color:#1a2b5f;margin-bottom:2px}.step-text span{font-size:13px;color:#5a6488;line-height:1.5}.security-tips{background:#f0f7ff;border-radius:14px;padding:16px 20px}.security-tips h4{font-size:14px;font-weight:700;color:#1a365f;margin:0 0 8px;display:flex;align-items:center;gap:6px}.security-tips ul{list-style:none;padding:0;margin:0}.security-tips li{font-size:12px;color:#5a6488;padding:3px 0;display:flex;align-items:center;gap:6px}.security-tips li::before{content:'✓';color:#52c41a;font-weight:700;font-size:11px}.dl-features{margin-top:20px}.dl-features h2{text-align:center;font-size:20px;font-weight:800;color:#1a2b5f;margin:0 0 24px}.feat-items{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.feat-item{background:#fff;border-radius:16px;padding:24px;box-shadow:0 2px 10px rgba(26,43,95,0.04);text-align:center;transition:all 0.3s}.feat-item:hover{transform:translateY(-2px);box-shadow:0 4px 16px rgba(26,43,95,0.08)}.feat-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 14px}.feat-item h4{font-size:15px;font-weight:700;color:#1a2b5f;margin:0 0 6px}.feat-item p{font-size:12px;color:#5a6488;margin:0;line-height:1.5}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:768px){.dl-main{padding:16px}.dl-hero{padding:40px 16px 24px}.hero-title{font-size:28px}.dl-scan-area{flex-direction:column;align-items:center}.qr-panel{width:100%;max-width:320px}.info-panel{width:100%}.feat-items{grid-template-columns:repeat(2,1fr)}}",
