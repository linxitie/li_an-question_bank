{
  "id": "jjvdntly",
  "css": ".home-page {\n  min-height: 100vh;\n  background: linear-gradient(180deg, #f8f9fc 0%, #f1f3f8 100%);\n  font-family: \"Noto Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n}\n.home-main {\n  max-width: 1400px;\n  margin: 0 auto;\n  padding: 24px 32px 0;\n}\n/* 上层模块 */\n.top-section {\n  display: grid;\n  grid-template-columns: 280px 1fr 320px;\n  gap: 20px;\n  margin-bottom: 28px;\n}\n.left-col {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.center-col {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.right-col {\n  display: flex;\n}\n/* 中层模块 */\n.recruit-section, .resource-section {\n  margin-bottom: 28px;\n}\n.section-header {\n  display: flex;\n  align-items: baseline;\n  gap: 12px;\n  margin-bottom: 16px;\n}\n.section-title {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 18px;\n  font-weight: 800;\n  color: #1a2b5f;\n  margin: 0;\n}\n.section-subtitle {\n  font-size: 13px;\n  color: #8a8faa;\n}\n.recruit-grid {\n  display: grid;\n  grid-template-columns: repeat(6, 1fr);\n  gap: 12px;\n}\n.recruit-card {\n  background: #ffffff;\n  border-radius: 14px;\n  padding: 16px 14px;\n  cursor: pointer;\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  box-shadow: 0 1px 8px rgba(26, 43, 95, 0.04);\n}\n.recruit-card:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 4px 18px rgba(26, 43, 95, 0.1);\n}\n.recruit-icon {\n  width: 42px;\n  height: 42px;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n.recruit-emoji {\n  font-size: 20px;\n}\n.recruit-info {\n  flex: 1;\n  min-width: 0;\n}\n.recruit-name {\n  font-size: 13px;\n  font-weight: 700;\n  color: #1a2b5f;\n  display: block;\n  margin-bottom: 2px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.recruit-count {\n  font-size: 11px;\n  color: #c41e3a;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n/* 下层模块 */\n.resource-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 20px;\n}\n.resource-card {\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 24px;\n  cursor: pointer;\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  box-shadow: 0 2px 12px rgba(26, 43, 95, 0.05);\n  position: relative;\n  overflow: hidden;\n}\n.resource-card:hover {\n  transform: translateY(-3px);\n  box-shadow: 0 6px 24px rgba(26, 43, 95, 0.12);\n}\n.resource-card::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 4px;\n  height: 100%;\n  border-radius: 4px 0 0 4px;\n}\n.xc-card::before {\n  background: #3b82f6;\n}\n.sl-card::before {\n  background: #f59e0b;\n}\n.ga-card::before {\n  background: #c41e3a;\n}\n.card-badge {\n  display: inline-block;\n  padding: 3px 10px;\n  border-radius: 10px;\n  font-size: 11px;\n  font-weight: 700;\n  margin-bottom: 12px;\n  letter-spacing: 1px;\n}\n.xc-card .card-badge {\n  background: #eff6ff;\n  color: #3b82f6;\n}\n.sl-card .card-badge {\n  background: #fffbeb;\n  color: #f59e0b;\n}\n.ga-card .card-badge {\n  background: #fef2f2;\n  color: #c41e3a;\n}\n.card-title {\n  font-size: 17px;\n  font-weight: 800;\n  color: #1a2b5f;\n  margin: 0 0 8px;\n}\n.card-desc {\n  font-size: 13px;\n  color: #5a6488;\n  margin: 0 0 12px;\n  line-height: 1.5;\n}\n.card-topics {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-bottom: 16px;\n}\n.card-topics span {\n  padding: 4px 10px;\n  background: #f8f9fc;\n  border-radius: 8px;\n  font-size: 11px;\n  color: #5a6488;\n}\n.card-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  font-size: 12px;\n  color: #8a8faa;\n  padding-top: 12px;\n  border-top: 1px dashed #e8eaf0;\n}\n/* 底层 */\n.footer-section {\n  padding: 24px 0 32px;\n  text-align: center;\n  border-top: 1px solid #e8eaf0;\n}\n.footer-links {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  margin-bottom: 12px;\n}\n.footer-links a {\n  font-size: 13px;\n  color: #5a6488;\n  text-decoration: none;\n  transition: color 0.2s;\n}\n.footer-links a:hover {\n  color: #c41e3a;\n}\n.footer-divider {\n  color: #d1d5db;\n  margin: 0 4px;\n}\n.footer-copy {\n  font-size: 11px;\n  color: #b0b7c3;\n  margin: 0;\n}",
