{
  "id": "signin_status",
  "css": "/* 签到卡片 */\n.signin-card {\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 20px;\n  border: 1px solid #e8ecf1;\n  box-shadow: 0 4px 20px rgba(10, 22, 40, 0.06);\n  height: 100%;\n}\n/* 卡片标题 */\n.card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 16px;\n}\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.header-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: #1a2a4a;\n  letter-spacing: 1px;\n}\n/* 连续签到天数 */\n.streak-count {\n  font-size: 13px;\n  font-weight: 600;\n  color: #c8161e;\n  background: linear-gradient(135deg, rgba(200, 22, 30, 0.08) 0%, rgba(200, 22, 30, 0.04) 100%);\n  padding: 4px 12px;\n  border-radius: 16px;\n  border: 1px solid rgba(200, 22, 30, 0.15);\n  animation: streak-glow 2s ease-in-out infinite;\n}\n@keyframes streak-glow {\n  0%, 100% {\n    box-shadow: 0 0 4px rgba(200, 22, 30, 0.2);\n  }\n  50% {\n    box-shadow: 0 0 12px rgba(200, 22, 30, 0.4);\n  }\n}\n/* 迷你日历 */\n.calendar-mini {\n  margin-bottom: 16px;\n  background: #fafbfc;\n  border-radius: 12px;\n  padding: 12px;\n  border: 1px solid #f0f2f5;\n}\n.calendar-weekdays {\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  gap: 2px;\n  margin-bottom: 6px;\n}\n.weekday-label {\n  text-align: center;\n  font-size: 10px;\n  font-weight: 600;\n  color: #8899aa;\n  padding: 4px 0;\n}\n.calendar-days {\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  gap: 2px;\n}\n/* 日历日 */\n.calendar-day {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  aspect-ratio: 1;\n  border-radius: 6px;\n  cursor: default;\n  transition: all 0.25s ease;\n  position: relative;\n  background: transparent;\n  font-size: 12px;\n  color: #c0c8d4;\n}\n.calendar-day.day-signed {\n  background: rgba(200, 22, 30, 0.08);\n  color: #c8161e;\n  font-weight: 500;\n}\n.calendar-day.day-today {\n  background: linear-gradient(135deg, #0d1b2a 0%, #152238 100%);\n  color: #ffffff;\n  font-weight: 700;\n  box-shadow: 0 2px 8px rgba(10, 22, 40, 0.25);\n  transform: scale(1.05);\n}\n.day-number {\n  font-size: 11px;\n  line-height: 1;\n}\n.day-dot {\n  width: 3px;\n  height: 3px;\n  border-radius: 50%;\n  background: #c8161e;\n  margin-top: 2px;\n}\n.calendar-day.day-today .day-dot {\n  background: #ffffff;\n}\n/* 做题量统计 */\n.exercise-stats {\n  display: flex;\n  align-items: center;\n  justify-content: space-around;\n  padding: 12px 0;\n  background: linear-gradient(135deg, rgba(10, 22, 40, 0.02) 0%, rgba(200, 22, 30, 0.02) 100%);\n  border-radius: 12px;\n  border: 1px solid #f0f2f5;\n}\n.stat-item {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n}\n.stat-number {\n  font-size: 22px;\n  font-weight: 700;\n  color: #c8161e;\n  font-family: \"JetBrains Mono\", \"Consolas\", monospace;\n}\n.stat-label {\n  font-size: 11px;\n  color: #8899aa;\n  font-weight: 500;\n}\n.stat-divider {\n  width: 1px;\n  height: 28px;\n  background: linear-gradient(180deg, transparent, #d0d8e0, transparent);\n}",
