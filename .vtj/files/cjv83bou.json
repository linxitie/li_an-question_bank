{
  "id": "cjv83bou",
  "css": "/* 个人小目标卡片 */\n.goal-card {\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 20px;\n  border: 1px solid #e8ecf1;\n  box-shadow: 0 4px 20px rgba(10, 22, 40, 0.06);\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n}\n/* 卡片标题 */\n.card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 16px;\n}\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.header-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: #1a2a4a;\n  letter-spacing: 1px;\n}\n.header-actions {\n  display: flex;\n  gap: 8px;\n}\n.set-goal-btn {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  background: transparent;\n  border: 1px solid rgba(200, 22, 30, 0.25);\n  color: #c8161e;\n  font-size: 12px;\n  font-weight: 500;\n  padding: 5px 12px;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.25s ease;\n}\n.set-goal-btn:hover {\n  background: rgba(200, 22, 30, 0.06);\n  border-color: #c8161e;\n}\n/* 目标进度列表 */\n.goal-progress-list {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n  margin-bottom: 16px;\n}\n/* 目标项 */\n.goal-item {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n.goal-info {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.goal-name {\n  font-size: 13px;\n  font-weight: 500;\n  color: #2c3e50;\n}\n.goal-value {\n  font-size: 12px;\n  font-weight: 600;\n  color: #8899aa;\n  font-family: \"JetBrains Mono\", \"Consolas\", monospace;\n}\n/* 进度条 */\n.progress-bar {\n  width: 100%;\n  height: 8px;\n  background: #f0f2f5;\n  border-radius: 4px;\n  overflow: hidden;\n  position: relative;\n}\n.progress-fill {\n  height: 100%;\n  background: linear-gradient(90deg, #c8161e 0%, #e63946 50%, #ff6b6b 100%);\n  border-radius: 4px;\n  transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);\n  position: relative;\n}\n.progress-fill::after {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);\n  animation: shimmer 2s infinite;\n}\n@keyframes shimmer {\n  0% {\n    transform: translateX(-100%);\n  }\n  100% {\n    transform: translateX(100%);\n  }\n}\n/* 明日计划 */\n.tomorrow-plan {\n  flex: 1;\n  background: linear-gradient(135deg, rgba(230, 126, 34, 0.04) 0%, rgba(230, 126, 34, 0.01) 100%);\n  border-radius: 10px;\n  padding: 12px;\n  border: 1px solid rgba(230, 126, 34, 0.1);\n}\n.plan-header {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin-bottom: 8px;\n}\n.plan-title {\n  font-size: 13px;\n  font-weight: 600;\n  color: #e67e22;\n}\n.plan-content {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n.plan-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12px;\n  color: #2c3e50;\n}\n.plan-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n/* 弹窗样式 */\n.goal-dialog-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(10, 22, 40, 0.5);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n  backdrop-filter: blur(4px);\n}\n.goal-dialog {\n  background: #ffffff;\n  border-radius: 16px;\n  width: 380px;\n  max-width: 90%;\n  box-shadow: 0 20px 50px rgba(10, 22, 40, 0.3);\n  animation: dialog-in 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  overflow: hidden;\n}\n@keyframes dialog-in {\n  from {\n    opacity: 0;\n    transform: scale(0.9) translateY(20px);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1) translateY(0);\n  }\n}\n.dialog-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 16px 20px;\n  border-bottom: 1px solid #f0f2f5;\n  background: linear-gradient(135deg, #fafbfc 0%, #f5f6f8 100%);\n}\n.dialog-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: #1a2a4a;\n}\n.dialog-close {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  border-radius: 8px;\n  border: none;\n  background: transparent;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n.dialog-close:hover {\n  background: #f0f2f5;\n}\n.dialog-body {\n  padding: 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.dialog-field {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n.dialog-field label {\n  font-size: 13px;\n  font-weight: 500;\n  color: #2c3e50;\n}\n.dialog-field input {\n  height: 40px;\n  border: 1px solid #e0e4e8;\n  border-radius: 8px;\n  padding: 0 12px;\n  font-size: 14px;\n  color: #2c3e50;\n  background: #fafbfc;\n  transition: all 0.25s ease;\n  outline: none;\n}\n.dialog-field input:focus {\n  border-color: #c8161e;\n  box-shadow: 0 0 0 3px rgba(200, 22, 30, 0.08);\n  background: #ffffff;\n}\n.dialog-save-btn {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  height: 42px;\n  background: linear-gradient(135deg, #0d1b2a 0%, #152238 100%);\n  color: #ffffff;\n  border: none;\n  border-radius: 8px;\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.3s ease;\n  margin-top: 4px;\n}\n.dialog-save-btn:hover {\n  background: linear-gradient(135deg, #152238 0%, #1a2a4a 100%);\n  transform: translateY(-1px);\n  box-shadow: 0 4px 12px rgba(10, 22, 40, 0.25);\n}\n.dialog-save-btn:active {\n  transform: scale(0.98);\n}",
