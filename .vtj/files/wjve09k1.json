{
  "id": "wjve09k1",
  "css": ".signin-card {\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 20px;\n  box-shadow: 0 2px 16px rgba(26, 43, 95, 0.06);\n  transition: all 0.3s;\n}\n.signin-card:hover {\n  box-shadow: 0 4px 20px rgba(26, 43, 95, 0.1);\n}\n.card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 16px;\n}\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.calendar-icon {\n  font-size: 20px;\n}\n.header-title {\n  font-size: 15px;\n  font-weight: 700;\n  color: #1a2b5f;\n}\n.signin-streak {\n  display: flex;\n  align-items: baseline;\n  gap: 4px;\n  background: linear-gradient(135deg, #fff5f5, #fff);\n  padding: 4px 12px;\n  border-radius: 12px;\n}\n.streak-number {\n  font-size: 22px;\n  font-weight: 900;\n  color: #c41e3a;\n}\n.streak-label {\n  font-size: 12px;\n  color: #5a6488;\n}\n.week-calendar {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 20px;\n  justify-content: center;\n}\n.day-cell {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  width: 40px;\n  padding: 8px 4px;\n  border-radius: 10px;\n  background: #f8f9fc;\n  transition: all 0.3s;\n  position: relative;\n}\n.day-cell.today {\n  background: linear-gradient(180deg, #1a2b5f, #1e3470);\n  box-shadow: 0 2px 10px rgba(26, 43, 95, 0.3);\n}\n.day-cell.today .day-date,\n.day-cell.today .day-week {\n  color: #ffffff;\n}\n.day-cell.signed {\n  background: #e6f7ec;\n}\n.day-cell.missed {\n  background: #fff0f0;\n}\n.day-date {\n  font-size: 14px;\n  font-weight: 700;\n  color: #1a2b5f;\n}\n.day-week {\n  font-size: 10px;\n  color: #8a8faa;\n  margin-top: 2px;\n}\n.day-badge {\n  position: absolute;\n  top: -6px;\n  right: -6px;\n  width: 18px;\n  height: 18px;\n  border-radius: 50%;\n  background: #22c55e;\n  color: #fff;\n  font-size: 10px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 1px 4px rgba(34, 197, 94, 0.3);\n}\n.day-badge.missed {\n  background: #e5e7eb;\n  color: #9ca3af;\n  box-shadow: none;\n}\n.stats-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-around;\n  padding: 14px 0;\n  background: #f8f9fc;\n  border-radius: 12px;\n  margin-bottom: 16px;\n}\n.stat-item {\n  text-align: center;\n}\n.stat-value {\n  font-size: 20px;\n  font-weight: 900;\n  color: #1a2b5f;\n  font-family: \"DIN Alternate\", \"SF Pro Display\", sans-serif;\n}\n.stat-label {\n  font-size: 11px;\n  color: #8a8faa;\n  margin-top: 4px;\n}\n.stat-divider {\n  width: 1px;\n  height: 32px;\n  background: #e8eaf0;\n}\n.signin-btn {\n  width: 100%;\n  padding: 12px;\n  border: none;\n  border-radius: 12px;\n  background: linear-gradient(135deg, #c41e3a, #e8384f);\n  color: #ffffff;\n  font-size: 15px;\n  font-weight: 700;\n  cursor: pointer;\n  transition: all 0.3s;\n  letter-spacing: 2px;\n  box-shadow: 0 2px 12px rgba(196, 30, 58, 0.3);\n}\n.signin-btn:hover:not(:disabled) {\n  transform: translateY(-1px);\n  box-shadow: 0 4px 18px rgba(196, 30, 58, 0.4);\n}\n.signin-btn:disabled {\n  background: #d1d5db;\n  box-shadow: none;\n  cursor: default;\n}",
