{
  "id": "mobile_forum",
  "__VERSION__": "1788919369989",
  "name": "MobileForum",
  "css": ".mobile-forum-page{min-height:100vh;background:#f5f7fa;font-family:'PingFang SC','Microsoft YaHei','Noto Sans SC',sans-serif;display:flex;flex-direction:column}.top-nav{display:flex;align-items:center;justify-content:space-between;height:56px;padding:0 16px;background:#ffffff;border-bottom:1px solid #f0f2f5;position:sticky;top:0;z-index:100}.nav-left,.nav-right{width:40px;display:flex;align-items:center;justify-content:center}.nav-back,.nav-icon{cursor:pointer;transition:opacity 0.2s}.nav-back:hover,.nav-icon:hover{opacity:0.7}.nav-title{font-size:18px;font-weight:700;color:#1A365D;margin:0}.category-tabs{background:#ffffff;border-bottom:1px solid #f0f2f5;padding:12px 16px}.tab-scroll{display:flex;gap:12px;overflow-x:auto;-webkit-overflow-scrolling:touch}.tab-item{padding:8px 16px;border-radius:20px;font-size:14px;font-weight:500;color:#5a6488;background:#f5f7fa;cursor:pointer;transition:all 0.3s ease;white-space:nowrap}.tab-item.active{background:#1A365D;color:#ffffff}.tab-item:hover:not(.active){background:#e8ecf1}.main-content{flex:1;padding:16px;overflow-y:auto;padding-bottom:100px}.post-list{display:flex;flex-direction:column;gap:12px}.post-card{background:#ffffff;border-radius:12px;padding:16px;box-shadow:0 2px 8px rgba(26,54,95,0.04);cursor:pointer;transition:all 0.3s ease}.post-card:hover{box-shadow:0 4px 16px rgba(26,54,95,0.1)}.post-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.author-info{display:flex;align-items:center;gap:10px}.author-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center}.author-detail{display:flex;flex-direction:column}.author-name{font-size:14px;font-weight:600;color:#1a2b5f}.post-time{font-size:12px;color:#8899aa}.post-tag{padding:4px 10px;border-radius:6px;font-size:11px;font-weight:600}.post-content{margin-bottom:12px}.post-title{font-size:16px;font-weight:600;color:#1a2b5f;margin:0 0 8px;line-height:1.4}.post-excerpt{font-size:14px;color:#5a6488;line-height:1.5;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.post-images{display:flex;gap:8px;margin-bottom:12px}.post-image{width:80px;height:80px;border-radius:8px;overflow:hidden;background:#f5f7fa}.post-image img{width:100%;height:100%;object-fit:cover}.post-footer{display:flex;justify-content:space-between;align-items:center;padding-top:12px;border-top:1px solid #f0f2f5}.post-stats{display:flex;gap:16px}.stat-item{display:flex;align-items:center;gap:4px;font-size:13px;color:#8899aa}.more-btn{cursor:pointer;padding:4px}.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px 20px;text-align:center}.empty-state p{font-size:14px;color:#8899aa;margin:16px 0 0}.fab-button{position:fixed;bottom:80px;right:20px;width:56px;height:56px;background:linear-gradient(135deg,#1A365D 0%,#2a5298 100%);border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(26,54,95,0.3);cursor:pointer;transition:all 0.3s ease;z-index:99}.fab-button:hover{transform:scale(1.1)}.bottom-tab-bar{position:fixed;bottom:0;left:0;right:0;height:60px;background:#ffffff;display:flex;justify-content:space-around;align-items:center;border-top:1px solid #f0f2f5;padding-bottom:env(safe-area-inset-bottom,0);z-index:100}.tab-item{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;height:100%;cursor:pointer;transition:all 0.2s}.tab-item.active{color:#1A365D}.tab-item:not(.active){color:#a0a4b8}.tab-label{font-size:10px;font-weight:500;margin-top:2px}@media(max-width:375px){.post-card{padding:12px}.post-title{font-size:15px}.fab-button{width:50px;height:50px;bottom:70px;right:16px}}",
  "emits": [],
  "nodes": [],
  "props": [],
  "slots": [],
  "state": {
    "activeTab": "'forum'",
    "activeCategory": "'all'"
  },
  "methods": {
    "goBack": {
      "type": "method"
    },
    "selectTab": {
      "type": "method",
      "params": [
        "key"
      ]
    },
    "createPost": {
      "type": "method"
    },
    "viewPost": {
      "type": "method",
      "params": [
        "post"
      ]
    },
    "switchTab": {
      "type": "method",
      "params": [
        "tab"
      ]
    },
    "onAvatarError": {
      "type": "method",
      "params": [
        "post"
      ]
    }
  },
  "computed": {},
  "lifeCycles": {},
  "dataSources": {},
  "__VTJ_BLOCK__": true
}