# ============================================================
# 砺安题库 .gitignore
#
# 原则：
#   1) 生成物、运行时数据、凭据、AI 本地缓存不入库；
#   2) .vtj/ 页面源码与 backend/data/gates 基线必须入库（见 AGENTS.md R1）；
#   3) 已跟踪文件不受 ignore 影响，需配合 git rm --cached 才能停止跟踪。
# ============================================================

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 编辑器 / 操作系统 ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvsproj
*.njsproj
*.sln
*.sw?
.history

# ---------- 前端依赖与构建产物 ----------
node_modules/
dist/
dist-ssr/
coverage/
*.local
*.tsbuildinfo
yarn.lock
pnpm-lock.yaml
.vite/
test-results/
playwright-report/

# ---------- VTJ ----------
# R1：.vtj/ 是 75 个页面 + 74 个 DSL 的源码目录，禁止整体忽略或移动。
# 只忽略设计器运行时日志与自动备份；已入库的 55 个 .bak 保持跟踪。
.vtj/logs/
.vtj/histories/
src/.vtj/logs/
src/.vtj/histories/
.vtj/**/*.bak*
.vtj/**/*.orig

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ---------- 数据库 / 运行时数据 ----------
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.db.backup
backend/uploads/
backend/mineru_env/
backend/tmp/
backend/_*.txt
mineru_verify_out/
mineru_run.log
mineru_err.log
sample_scanned.pdf
sample_scanned.png
backend/backend_pid.txt
git_diff_qi.txt
frontend_run.err
frontend_run.log

# ---------- 门禁数据 ----------
# 注意：必须用 backend/data/* 而非 backend/data/，否则下面的反选规则失效
# （gitignore 规则：被排除的目录无法被反选）。
backend/data/*
# 5 个门禁基线必须入库，否则 L0/L1/L2 红线与基线无法在 CI 与其他机器上复现。
!backend/data/gates/
!backend/data/gates/*.json
# 门禁爬取的文本缓存（85 份 PDF 的提取产物，可随时重建，不入库）。
backend/data/gates/*_cache/
# gate_all.py 每次运行都会覆写，属于运行时产物（已从索引移除）。
backend/data/gates/last_run.json

# ---------- 题目图片 ----------
# 运行时题图目录；历史已跟踪的 747 个文件仍在索引中，
# 如需彻底瘦身需单独迁移，勿直接删除 backend/app/static/（R7）。
backend/app/static/questions/

# ---------- 容器化 staging 运行时数据 ----------
# deploy/preflight.sh 与 docker compose 的 staging 数据目录；绝不入库。
deploy/runtime/
# TLS 证书与私钥不入库（保留 README 与生成脚本）
deploy/certs/*.crt
deploy/certs/*.key
deploy/certs/*.pem

# ---------- 凭据 ----------
# 真实环境变量文件一律不入库；模板 *.env.example 放行。
.env
.env.*
!.env.example
!**/.env.example
backend/.env
deploy/.env*
!deploy/.env.example
!deploy/.env.production.example
# 本地 MCP 配置与管理员令牌（已从索引移除；历史泄露的密钥请轮换）。
.obsidian_mcp.json
admin_token.txt
*.pem
*.key
*.p12
*.pfx

# ---------- AI 工具本地缓存 / 草稿 ----------
.omo/
.opencode/
.superpowers/
.worktrees/
.claude/settings.local.json
.claude/skills/
.claude/资源优化skills
.playwright-mcp/

# ---------- Word 锁文件（多人/多机编辑时产生） ----------
~$*.docx

# ---------- 大体积本地资料 ----------
# R6：只停止跟踪，不删除/移动 题库/ 目录。
# 题库/备考资料/ 为参考 PDF（约 190 MB），本地保留，不再入库。
题库/备考资料/

# ---------- dsh 项目技能联接 ----------
# .dsh/skills 是指向 .opencode/skills 的 Windows 目录联接，仅为让 dsh 按
# project-dsh 根发现项目技能。不忽略会让 git 穿过联接把 20 个技能重复登记。
.dsh/skills

# ---------- 本地运行时残留 ----------
backend/backend_pid.txt
backend/_badge_write_test.txt

# 2026-10-29：本地文档索引与归档目录不纳入版本控制（用户决定）
docs/README.md
solve_problems_files/

# ===== 2026-10-30：数据库与日志不入库（体积大）=====
*.sqlite-wal
*.sqlite-shm
backend/data/*.sqlite*
backend/data/*.db*

