.idea
.DS_Store
*.suo
*.ntvsproj
*.njsproj
*.sln
*.sw?
.history

# Project
yarn-lock.json
pnpm-lock.yaml
tsconfig.tsbuildinfo
node_modules
coverage
dist
dist-ssr
*.local
