mineru_err.log
sample_scanned.pdf
sample_scanned.png

# Worktrees
.worktrees

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Playwright 测试临时快照
.playwright-mcp/

# AI 工具运行时目录（52 MB，含插件/技能/缓存；权威副本在 .agents/）
.opencode/
# 机器本地 AI 配置（权限白名单因机而异）
.claude/settings.local.json
# 技能已迁至 .agents/skills/，此处残留的空壳嵌套仓库（内含 .git，不可入库）
.claude/skills/

# Word 锁文件（多人/多机编辑时产生的 ~$*.docx）
~$*.docx

# 根目录临时产物
git_diff_qi.txt
frontend_run.err
frontend_run.log

# 一次性探测临时输出（探测脚本本体保留在 backend/scripts/probe/）
backend/tmp/
backend/_*.txt

# 运行时数据（新闻图片、上传资料、题目图片、SQLite 数据库）
backend/uploads/
# 注意：此处必须用 backend/data/* 而非 backend/data/，否则 git 会跳过目录本身，
# 导致下面的 !backend/data/gates/ 反选规则失效（gitignore 规则：被排除的目录无法被反选）。
backend/data/*
# 门禁基线必须入库：否则 L0/L1/L2 红线与基线无法在 CI 与其他机器上复现，
# 门禁网会退化成「只在本机有效」。DB / 缓存 / 备份仍保持忽略。
!backend/data/gates/
!backend/data/gates/*.json
# 门禁爬取的文本缓存（85 份 PDF 的提取产物，可随时重建，不入库）
backend/data/gates/*_cache/
backend/app/static/questions/
*.db-wal
*.db-shm
*.db.backup

# 运行时/会话元数据与嵌套技能仓库（不纳入版本控制）
.omo/run-continuation/
.claude/资源优化skills
backend/backend_pid.txt
backend/_badge_write_test.txt
