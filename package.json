{
  "name": "vtj-web-template",
  "description": "VTJ.PRO Web 项目模版",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=20.19.0 <25",
    "npm": ">=10 <12"
  },
  "repository": {
    "url": "https://gitee.com/newgateway/vtj"
  },
  "homepage": "https://vtj.pro",
  "scripts": {
    "setup": "npm ci",
    "dev": "cross-env ENV_TYPE=local vite",
    "prebuild": "node scripts/verify-project-health.mjs",
    "build": "npm run build:prod",
    "build:sit": "npm run typecheck:guarded && cross-env ENV_TYPE=sit vite build",
    "build:uat": "npm run typecheck:guarded && cross-env ENV_TYPE=uat vite build",
    "build:pre": "npm run typecheck:guarded && cross-env ENV_TYPE=pre vite build",
    "build:prod": "npm run typecheck:guarded && cross-env ENV_TYPE=live vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:guarded": "node scripts/verify-typecheck-baseline.mjs",
    "verify:health": "node scripts/verify-project-health.mjs",
    "test:vite-resilience": "node scripts/verify-vite-resilience.mjs",
    "preview": "vite preview",
    "clean": "node ./scripts/clean.mjs",
    "sync:vtj-version": "node ./scripts/sync_vtj_version.mjs",
    "prebuild": "npm run sync:vtj-version",
    "mcp:setup": "cd vtj-mcp-server && npm install",
    "mcp:start": "node vtj-mcp-server/vtj-mcp-server.js",
    "mcp:test": "node -e \"const{spawn}=require('child_process');const s=spawn('node',['vtj-mcp-server/vtj-mcp-server.js']);let o='';s.stdout.on('data',d=>o+=d);s.on('close',()=>{const r=JSON.parse(o);console.log('VTJ MCP Server -',r.result.tools.length,'tools registered');r.result.tools.forEach(t=>console.log(' ✅',t.name))});s.stdin.write(JSON.stringify({jsonrpc:'2.0',id:1,method:'tools/list',params:{}})+'\\n');setTimeout(()=>s.stdin.end(),2000);\""
  },
  "dependencies": {
    "@vtj/charts": "0.16.35",
    "@vtj/icons": "0.16.35",
    "@vtj/ui": "0.16.35",
    "@vtj/utils": "0.16.35",
    "@vtj/web": "0.16.35",
    "@vueuse/core": "14.1.0",
    "ant-design-vue": "4.2.6",
    "axios": "1.13.6",
    "docx-preview": "0.3.7",
    "element-plus": "2.13.7",
    "mammoth": "1.8.0",
    "mockjs": "1.1.0",
    "pinia": "3.0.4",
    "vue": "3.5.34",
    "vue-i18n": "11.2.8",
    "vue-router": "4.6.4",
    "wangeditor": "4.7.15",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@vtj/cli": "0.12.19",
    "@vtj/materials": "0.16.35",
    "@vtj/pro": "0.16.35",
    "cross-env": "7.0.3",
    "typescript": "5.9.3",
    "vite": "6.3.7",
    "vue-tsc": "3.3.11",
    "ws": "8.20.1"
  },
  "vtj": {
    "platform": "web",
    "id": "linxitie.policy-exam-bank",
    "name": "砺安题库",
    "remote": "https://app.vtj.pro"
  }
}
