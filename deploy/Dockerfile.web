# syntax=docker/dockerfile:1
#
# 前端镜像 —— Vite 构建 + nginx 反代，唯一对外入口
#
# 设计要点（见 docs/superpowers/specs/容器化部署方案_v2.0.md 8.2 / 8.7）：
#   - 前端 dist 进镜像，不再挂宿主机 ./dist，保证镜像不可变、可回滚。
#   - 运行阶段用 nginx-unprivileged，监听 8080，不依赖 root 绑定 80。
#   - 构建上下文是仓库根；根 .dockerignore 已排除题库/后端数据/密钥。
#
# 构建：
#   docker build -f deploy/Dockerfile.web -t liankao/web:dev .

FROM node:22-bookworm-slim AS build

WORKDIR /app

# 先只拷贝依赖清单，利用 Docker 层缓存；业务代码改动不触发 npm ci 重跑。
COPY package.json package-lock.json ./
RUN npm ci

# 业务源码、.vtj 页面与 DSL、构建脚本、tsconfig、typecheck 基线。
# .dockerignore 已排除 node_modules/dist/题库/backend 等无关或敏感内容。
COPY . .

# build:prod 内含 typecheck 基线守卫；typecheck 只依赖 src 与 .vtj。
RUN npm run build:prod


FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

# 镜像内只保留构建产物与服务器配置，不带 Node、源码或密钥。
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
