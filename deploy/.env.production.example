# 砺安题库 —— 生产容器化环境模板（P6）
#
# 用法：
#   cp deploy/.env.production.example deploy/.env.production
#   # 由用户本人填写 JWT_SECRET_KEY、IMAGE_TAG、SCHOOL_DOMAIN 与 /srv 路径
#   chmod 600 deploy/.env.production
#   bash deploy/release.sh --dry-run
#   bash deploy/release.sh
#
# 安全：本文件只放入模板；真实密钥不得提交 Git，不得写入文档/聊天记录。

# 项目与镜像
COMPOSE_PROJECT_NAME=liankao
IMAGE_PREFIX=ghcr.io/linxitie/li_an-question_bank
# 版本号只允许提交号/日期序号，禁止 latest；发布脚本会再次校验。
IMAGE_TAG=CHANGE_ME_VERSION
INSTALL_PLAYWRIGHT_BROWSERS=1

# Compose 读取的运行时环境文件（与本文件同一份即可）
APP_ENV_FILE=./.env.production

# 宿主端口：默认由学校网关反代到 8080；若直接对外可改 80/443。
HTTP_PORT=8080
HTTPS_PORT=443

# 生产数据根：必须为宿主机绝对路径，且与备份/巡检脚本使用同一组变量。
DATA_ROOT=/srv/liankao/data
STATIC_ROOT=/srv/liankao/static
UPLOAD_ROOT=/srv/liankao/uploads
LOG_ROOT=/srv/liankao/logs

# 数据库：SQLite 唯一事实源，不容器化。
DB_TYPE=sqlite
SQLITE_PATH=/app/data/question_bank.db
WEB_CONCURRENCY=1

# 密钥：必须由用户本人用 openssl rand -base64 48 生成；占位符会被 preflight 拒绝。
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48

# 容器内用户（需对 DATA/STATIC/UPLOAD/LOG 有读写权限）
APP_UID=1000
APP_GID=1000

# 学校域名与 TLS 模式：gateway=学校网关终止 TLS；overlay=本 compose 叠加 nginx.tls.conf。
SCHOOL_DOMAIN=exam.example.edu.cn
TLS_MODE=gateway

# OCR sidecar：启用时设为 http://parser:8080，并用 --profile ocr 启动 parser。
PARSER_URL=
MINERU_ENABLED=false
MINERU_PYTHON=
MINERU_TIMEOUT=600
MINERU_BACKEND=pipeline
MINERU_MODEL_SOURCE=modelscope

# 时区与日志级别
TZ=Asia/Shanghai
UVICORN_LOG_LEVEL=info
