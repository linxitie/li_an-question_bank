# 环境下发模板 —— 复制为 .env.development 或 .env.school 后填写
#
#   cp deploy/.env.example deploy/.env.development
#
# .env.development / .env.school 含真实密钥，已被 .gitignore 排除，禁止提交。
# 本文件只放占位符，是唯一可以进版本库的那份。
#
# ⚠ 密钥生成（由使用者本人执行，AI 不经手密钥值）：
#     python -c "import secrets; print(secrets.token_urlsafe(48))"

# ============ 编排层 ============
TAG=latest
HTTP_PORT=80
BACKEND_PORT=8000
PARSER_PORT=8080

# ============ 数据库 ============
DB_TYPE=sqlite
# 容器内路径。SQLite 走 WAL 模式（R10），卷必须持久化。
SQLITE_PATH=/app/data/question_bank.db
DB_HOST=localhost
DB_PORT=3306
DB_USER=police_exam
# 容器化部署用 SQLite，该项留空即可。config.py 已改为 Optional[str] = None。
DB_PASSWORD=
DB_NAME=police_exam
DB_CHARSET=utf8mb4

# ============ Redis（事件总线，P5 阶段启用；当前留空即不启用）============
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============ 鉴权 ============
# 必填，至少 32 字符。以下为占位符，不得直接使用。
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_48
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ============ 服务 ============
HOST=0.0.0.0
PORT=8000
DEBUG=false
BCRYPT_ROUNDS=12
UVICORN_LOG_LEVEL=info

# ============ 解析器 ============
# 置空则回落本地子进程路径；配置则优先走 sidecar HTTP。
PARSER_URL=http://parser:8080
MINERU_ENABLED=true
# 容器内 MinerU 装在 sidecar 里，主后端不需要本地解释器路径。
MINERU_PYTHON=
MINERU_TIMEOUT=600
MINERU_BACKEND=pipeline
MINERU_MODEL_SOURCE=modelscope