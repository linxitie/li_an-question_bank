# 砺安题库容器化环境模板（v2 设计 P1）
#
# 复制为 deploy/.env.development（staging）或服务器上的 .env.production 后填写。
# 真实文件已被 .gitignore 排除，禁止提交。
#
#   cp deploy/.env.example deploy/.env.development
#   # 由用户本人填写 JWT_SECRET_KEY 与 *_ROOT
#   bash deploy/preflight.sh
#
# 相对路径约定：本文件中的相对路径以 deploy/ 为基准（Compose 文件所在目录）。
# 生产环境建议全部改为绝对路径，如 /srv/liankao/data。
#
# ⚠ JWT_SECRET_KEY 由使用者本人生成，AI 不经手真实值：
#     python -c "import secrets; print(secrets.token_urlsafe(48))"

# ============ 编排层 ============
COMPOSE_PROJECT_NAME=liankao
# 镜像名前缀；本地构建可改为 liankao，推送 GHCR 时用 ghcr.io/linxitie/li_an-question_bank
IMAGE_PREFIX=ghcr.io/linxitie/li_an-question_bank
# 禁止 latest；staging 可用 dev，生产必须用提交号或版本号
IMAGE_TAG=dev
# 1=安装 Chromium（生产爬虫需要，约 191MB）；0=跳过（staging/CI 快速构建）
INSTALL_PLAYWRIGHT_BROWSERS=1
# Compose 服务 env_file；相对路径以 deploy/ 为基准
APP_ENV_FILE=./.env.development
# 仅 web 对宿主开放；staging 默认 8080，生产可改 80
HTTP_PORT=8080
TZ=Asia/Shanghai

# ============ 宿主数据目录（必须已存在）============
# staging 默认放在 deploy/runtime/（已 gitignore）；生产改为 /srv/liankao/*
DATA_ROOT=./runtime/data
STATIC_ROOT=./runtime/static
UPLOAD_ROOT=./runtime/uploads
LOG_ROOT=./runtime/logs
# 与宿主目录属主一致；Linux 上需 chown -R 1000:1000 上述目录
APP_UID=1000
APP_GID=1000

# ============ 数据库 ============
DB_TYPE=sqlite
# 容器内路径；宿主对应 $DATA_ROOT/question_bank.db
SQLITE_PATH=/app/data/question_bank.db
DB_HOST=localhost
DB_PORT=3306
DB_USER=police_exam
DB_PASSWORD=
DB_NAME=police_exam
DB_CHARSET=utf8mb4

# ============ Redis（当前禁用；多 worker 才启用）============
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
WS_RELAY=

# ============ 鉴权 ============
# 必填，≥32 字符。占位符必须以 your- 开头，供 check_secrets.py 白名单放行。
JWT_SECRET_KEY=your-secret-generate-with-secrets-token-urlsafe-48
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ============ 服务 ============
HOST=0.0.0.0
PORT=8000
DEBUG=false
BCRYPT_ROUNDS=12
UVICORN_LOG_LEVEL=info
# SQLite 单写者，固定 1；>1 会被 main.py validate_worker_config 拒绝
WEB_CONCURRENCY=1

# ============ 解析器（可选 OCR profile）============
# 留空 = 不启用 sidecar，后端回落本地子进程。
# 启用时改为 http://parser:8080，并用 --profile ocr 启动。
PARSER_URL=
MINERU_ENABLED=true
MINERU_PYTHON=
MINERU_TIMEOUT=600
MINERU_BACKEND=pipeline
MINERU_MODEL_SOURCE=modelscope

# ============ 四库可选后端（当前 local）============
OBJECT_STORE_BACKEND=local
